---
import '../styles/fonts.css';
import '../styles/global.css';
import NavIsland from '../components/NavIsland';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  current?: string;
  forestTop?: boolean;
}

const { title = 'Cooksbrad · Atelier Culinaire & Bar Mobile', description = '', current = 'home', forestTop = false } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content="#0c392d" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=3" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" />
    <link rel="icon" type="image/x-icon" sizes="48x48" href="/favicon.ico?v=3" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
    <title>{title}</title>
    <style>
      .skip-link {
        position: absolute;
        top: -100%;
        left: 0;
        z-index: 9999;
        padding: 12px 24px;
        background: #0c392d;
        color: #f7f5ef;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.875rem;
        text-decoration: none;
        transition: top 0.2s;
      }
      .skip-link:focus {
        top: 0;
      }
    </style>
  </head>
  <body class={forestTop ? 'page-forest-top' : ''}>
    <a href="#main-content" class="skip-link">Aller au contenu principal</a>
    <NavIsland client:load current={current} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script src="/js/cooksbrad-anim.js" is:inline></script>
  </body>
</html>
