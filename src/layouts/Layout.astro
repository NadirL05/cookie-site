---
import '../styles/fonts.css';
import '../styles/global.css';
import NavIsland from '../components/NavIsland';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  current?: string;
  forestTop?: boolean;
  image?: string;
}

const {
  title = 'Cooksbrad · Atelier Culinaire & Bar Mobile',
  description = '',
  current = 'home',
  forestTop = false,
  image = '/garden-party.jpeg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'CooksBrad',
  description:
    "Bar mobile événementiel et atelier de cookies artisanaux, basé à Aubagne, intervenant dans toute la région Provence-Alpes-Côte d'Azur pour mariages, événements d'entreprise et soirées privées.",
  url: Astro.site,
  logo: new URL('/logo-cooksbrad-square.png', Astro.site),
  image: new URL('/garden-party.jpeg', Astro.site),
  email: 'cooksbrad.pro@gmail.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Aubagne',
    addressRegion: 'Provence-Alpes-Côte d’Azur',
    addressCountry: 'FR',
  },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: "Provence-Alpes-Côte d'Azur",
  },
  sameAs: ['https://www.instagram.com/maison.cooksbrad/', 'https://www.tiktok.com/@cooksbrad'],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content="#0c392d" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=3" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" />
    <link rel="icon" type="image/x-icon" sizes="48x48" href="/favicon.ico?v=3" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CooksBrad" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

    <Analytics />
    <style>
      .skip-link {
        position: absolute;
        top: -100%;
        left: 0;
        z-index: 9999;
        padding: 12px 24px;
        background: #0c392d;
        color: #f7f5ef;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.875rem;
        text-decoration: none;
        transition: top 0.2s;
      }
      .skip-link:focus {
        top: 0;
      }
    </style>
  </head>
  <body class={forestTop ? 'page-forest-top' : ''}>
    <a href="#main-content" class="skip-link">Aller au contenu principal</a>
    <NavIsland client:load current={current} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script src="/js/cooksbrad-anim.js" is:inline></script>
  </body>
</html>
