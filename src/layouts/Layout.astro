---
import '../styles/global.css';
import NavIsland from '../components/NavIsland';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  current?: string;
  forestTop?: boolean;
}

const { title = 'Cooksbrad · Atelier Culinaire & Bar Mobile', description = '', current = 'home', forestTop = false } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content="#2a2724" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Noto+Serif:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <style>
      .skip-link {
        position: absolute;
        top: -100%;
        left: 0;
        z-index: 9999;
        padding: 12px 24px;
        background: #2a2724;
        color: #F7F5EF;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.875rem;
        text-decoration: none;
        transition: top 0.2s;
      }
      .skip-link:focus {
        top: 0;
      }
    </style>
  </head>
  <body class={forestTop ? 'page-forest-top' : ''}>
    <a href="#main-content" class="skip-link">Aller au contenu principal</a>
    <NavIsland client:load current={current} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script src="/js/cooksbrad-anim.js" is:inline></script>
  </body>
</html>
