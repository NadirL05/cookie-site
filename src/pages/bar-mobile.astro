---
import Layout from '../layouts/Layout.astro';

const ateliers = [
  {
    id: 'crepes',
    span: 'large',
    label: 'Tradition & Modernité',
    title: 'Bar à Crêpes',
    desc: 'Farine de blé noir bio, garnitures maison et show-cooking. Une animation conviviale qui sublime le patrimoine avec une touche contemporaine.',
    items: ['Caramel au beurre salé maison', 'Fruits frais de saison', 'Chocolat artisanal'],
    image: 'https://images.unsplash.com/photo-1565299507177-b0ac66763828?w=1200&q=80&auto=format&fit=crop',
  },
  {
    id: 'tiramisu',
    span: 'small',
    label: 'L\'Italie à l\'Honneur',
    title: 'Bar à Tiramisu',
    desc: 'Personnalisation en direct : choisissez votre biscuit, votre crème et vos toppings pour un dessert sur-mesure.',
    items: [],
    gold: true,
    image: null,
  },
  {
    id: 'cart',
    span: 'small',
    label: 'Bar Mobile',
    title: 'Le Bar Cart',
    desc: 'L\'élégance mobile pour vos cocktails et boissons fines. Verrerie cristal incluse.',
    items: [],
    image: null,
  },
  {
    id: 'custom',
    span: 'large',
    label: 'Sur Mesure',
    title: 'Créations Sur Mesure',
    desc: 'Un projet unique ? Nous créons le bar de vos rêves, adapté à votre lieu et à votre ambiance.',
    items: [],
    image: null,
    cta: true,
  },
];

const events = [
  {
    title: 'Mariages',
    desc: 'Une touche de magie et de gourmandise pour votre vin d\'honneur ou votre soirée dansante.',
    icon: '♡',
    image: 'https://images.unsplash.com/photo-1519741497674-611481863552?w=900&q=80&auto=format&fit=crop',
  },
  {
    title: 'Corporate',
    desc: 'Fédérez vos équipes autour d\'une animation culinaire prestige lors de vos séminaires et lancements.',
    icon: '◈',
    image: 'https://images.unsplash.com/photo-1551632436-cbf8dd35adfa?w=900&q=80&auto=format&fit=crop',
  },
  {
    title: 'Soirées Privées',
    desc: 'Anniversaires, garden parties ou réceptions intimes : l\'excellence CooksBrad chez vous.',
    icon: '✦',
    image: 'https://images.unsplash.com/photo-1575444758702-4a6b9222336e?w=900&q=80&auto=format&fit=crop',
  },
];
---

<Layout
  title="Bar mobile événementiel — Cooksbrad"
  description="Bar mobile événementiel CooksBrad : bars à crêpes, tiramisu, cocktails et animations sur mesure pour mariages, corporate et soirées privées."
  current="bar-mobile"
>

  <!-- Hero -->
  <section class="bar-hero">
    <img
      class="bar-hero-img"
      src="https://images.unsplash.com/photo-1555507036-ab1f4038808a?w=2000&q=85&auto=format&fit=crop"
      alt="Bar mobile CooksBrad — crêpes et douceurs"
      loading="eager"
    />
    <div class="bar-hero-overlay"></div>

    <!-- Floating ornaments -->
    <div class="hero-orns" aria-hidden="true">
      <span class="hero-orn" style="--fs:1.3rem;--op:0.18;--dur:9s;--delay:0s;--travel:-16px;--rot:12deg;--scale:1.1;top:18%;left:8%">✦</span>
      <span class="hero-orn" style="--fs:0.8rem;--op:0.14;--dur:7s;--delay:1.5s;--travel:-12px;--rot:-8deg;--scale:1.07;top:28%;right:10%">✦</span>
      <span class="hero-orn" style="--fs:1.7rem;--op:0.10;--dur:11s;--delay:3s;--travel:-22px;--rot:7deg;--scale:1.04;bottom:25%;right:6%">✦</span>
    </div>

    <div class="bar-hero-content">
      <span class="bar-hero-label hero-animate hero-animate-0">CooksBrad Atelier</span>
      <div class="hero-title-wrap">
        <h1 class="bar-hero-title" style="animation: titleSlideUp 1.3s cubic-bezier(0.16,1,0.3,1) 0.32s forwards; opacity:0; transform:translateY(105%)">Bar Mobile</h1>
      </div>
      <p class="bar-hero-sub hero-animate hero-animate-2">Chic, Événementiel, Gourmand</p>
      <div class="hero-animate hero-animate-3" style="margin-top:32px">
        <a href="/contact" class="btn btn-primary">
          Demander un devis <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Concept section -->
  <section class="section bg-forest-low">
    <div class="container">
      <div class="bar-concept-grid">
        <div class="reveal">
          <span class="eyebrow" style="display:block;margin-bottom:12px">L'Art de Recevoir</span>
          <h2 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:600;font-size:clamp(2rem,4vw,3.4rem);color:#002f21;letter-spacing:-0.02em;line-height:1.1;margin-bottom:20px">
            Un Concept,<br/>Deux Ambiances
          </h2>
          <p class="body-text" style="margin-bottom:28px">
            CooksBrad réinvente l'animation de vos événements avec une solution mobile haut de gamme.
            Du bar à crêpes artisanal au bar à tiramisu sophistiqué, notre atelier se déplace pour créer
            une expérience visuelle et gustative inoubliable.
          </p>
          <div style="display:flex;gap:24px;flex-wrap:wrap">
            <div style="display:flex;align-items:center;gap:8px">
              <span style="color:#6e5d04;font-size:1rem">★</span>
              <span style="font-family:'Plus Jakarta Sans',sans-serif;font-size:0.65rem;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#002f21">Maître Artisan</span>
            </div>
            <div style="display:flex;align-items:center;gap:8px">
              <span style="color:#6e5d04;font-size:1rem">🍸</span>
              <span style="font-family:'Plus Jakarta Sans',sans-serif;font-size:0.65rem;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#002f21">Mise en Scène Élégante</span>
            </div>
          </div>
        </div>
        <div class="bar-concept-photos reveal reveal-delay-1">
          <div class="bar-concept-photo-a">
            <img
              src="https://images.unsplash.com/photo-1575444758702-4a6b9222336e?w=900&q=80&auto=format&fit=crop"
              alt="Le Cart"
              loading="lazy"
            />
            <div class="bar-concept-photo-label">Le Cart</div>
          </div>
          <div class="bar-concept-photo-b">
            <img
              src="https://images.unsplash.com/photo-1565299507177-b0ac66763828?w=900&q=80&auto=format&fit=crop"
              alt="Le Buffet"
              loading="lazy"
            />
            <div class="bar-concept-photo-label">Le Buffet</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Ateliers signatures — bento on dark bg -->
  <section class="section bg-forest">
    <div class="container">
      <div style="text-align:center;margin-bottom:56px" class="reveal">
        <h2 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:700;font-size:clamp(2rem,4vw,3.4rem);color:#D4AF37;letter-spacing:-0.02em;margin-bottom:8px">
          Nos Ateliers Signatures
        </h2>
        <p style="font-family:'Noto Serif',serif;font-style:italic;color:rgba(252,249,248,0.65);font-size:1rem">
          La précision du geste au service de la gourmandise.
        </p>
      </div>

      <div class="ateliers-bento reveal reveal-delay-1">
        <!-- Bar à Crêpes — large -->
        <div class="atelier-card atelier-large">
          <img
            class="atelier-bg-img"
            src="https://images.unsplash.com/photo-1565299507177-b0ac66763828?w=1200&q=80&auto=format&fit=crop"
            alt="Bar à Crêpes"
            loading="lazy"
          />
          <div class="atelier-content">
            <span style="font-family:'Plus Jakarta Sans',sans-serif;font-size:0.62rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:rgba(212,175,55,0.7);display:block;margin-bottom:12px">Tradition & Modernité</span>
            <h3 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:600;font-size:1.75rem;color:#fcf9f8;margin:0 0 12px">Bar à Crêpes</h3>
            <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:0.9rem;color:rgba(252,249,248,0.72);line-height:1.65;max-width:420px">
              Farine de blé noir bio, garnitures maison et show-cooking. Une animation conviviale qui sublime le patrimoine breton avec une touche contemporaine.
            </p>
            <ul class="atelier-list">
              <li>Caramel au beurre salé maison</li>
              <li>Fruits frais de saison</li>
              <li>Chocolat artisanal</li>
            </ul>
          </div>
        </div>

        <!-- Bar à Tiramisu — gold -->
        <div class="atelier-card atelier-gold">
          <div class="atelier-content">
            <span style="font-family:'Plus Jakarta Sans',sans-serif;font-size:0.62rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:rgba(0,47,33,0.6);display:block;margin-bottom:12px">L'Italie à l'Honneur</span>
            <h3 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:600;font-size:1.5rem;color:#002f21;margin:0 0 12px">Bar à Tiramisu</h3>
            <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:0.88rem;color:rgba(0,47,33,0.75);line-height:1.65">
              Personnalisation en direct : choisissez votre biscuit, votre crème et vos toppings pour un dessert sur-mesure.
            </p>
            <div style="margin-top:auto;padding-top:24px;font-size:2rem">🍰</div>
          </div>
        </div>

        <!-- Le Bar Cart — small dark -->
        <div class="atelier-card atelier-small-dark">
          <div class="atelier-content">
            <h3 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:500;font-size:1.2rem;color:#fcf9f8;margin:0 0 8px">Le Bar Cart</h3>
            <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:0.85rem;color:rgba(252,249,248,0.6);line-height:1.6;margin:0">L'élégance mobile pour vos cocktails et boissons fines.</p>
          </div>
        </div>

        <!-- Sur mesure — wide -->
        <div class="atelier-card atelier-cta">
          <div class="atelier-content" style="display:flex;align-items:center;justify-content:space-between;gap:16px">
            <div>
              <h3 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:500;font-size:1.3rem;color:#fcf9f8;margin:0 0 6px">Créations Sur Mesure</h3>
              <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:0.85rem;color:rgba(252,249,248,0.6);margin:0">Un projet unique ? Nous créons le bar de vos rêves.</p>
            </div>
            <a href="/contact" style="display:flex;align-items:center;color:#D4AF37;font-size:1.4rem;flex-shrink:0;transition:transform 0.25s">→</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pour chaque moment — events timeline -->
  <section class="section bg-cream">
    <div class="container">
      <div style="text-align:center;margin-bottom:64px" class="reveal">
        <span class="eyebrow" style="display:block;margin-bottom:12px">Célébrations</span>
        <h2 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:600;font-size:clamp(2rem,4vw,3.4rem);color:#002f21;letter-spacing:-0.02em">
          Pour Chaque Moment Unique
        </h2>
      </div>

      <div class="events-timeline">
        {events.map((ev, i) => (
          <div class={`event-row${i % 2 === 1 ? ' event-row-reverse' : ''} reveal`}>
            <div class="event-text">
              <h3 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:600;font-size:1.75rem;color:#002f21;margin:0 0 12px">{ev.title}</h3>
              <p class="body-text" style="margin:0">{ev.desc}</p>
            </div>
            <div class="event-dot">
              <div class="event-dot-circle"></div>
              <div class="event-dot-line"></div>
              <span class="event-dot-icon">{ev.icon}</span>
            </div>
            <div class="event-photo">
              <img
                src={ev.image}
                alt={ev.title}
                loading="lazy"
                class="event-photo-img"
              />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-band bg-surface">
    <div class="container reveal">
      <span class="eyebrow" style="color:#6e5d04;display:block;margin-bottom:8px">Votre Événement</span>
      <h2 style="color:#002f21">Prêt à sublimer<br/>votre événement ?</h2>
      <p class="body-text">
        Nos équipes étudient chaque projet pour vous proposer une expérience sur mesure,
        adaptée à vos envies et à votre lieu.
      </p>
      <a href="/contact" class="btn btn-primary">
        Planifier mon événement <span class="arrow">→</span>
      </a>
    </div>
  </section>

</Layout>

<style>
  /* Bar Hero */
  .bar-hero {
    position: relative; height: 100svh; min-height: 600px;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden; margin-top: 76px;
  }
  .bar-hero-img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; filter: brightness(0.42) saturate(0.85);
    animation: hero-kenburns 22s ease-in-out infinite alternate;
  }
  .bar-hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(0,47,33,0.35) 0%, rgba(0,18,10,0.82) 100%);
  }
  .bar-hero-content {
    position: relative; z-index: 2; text-align: center; color: #fcf9f8;
    padding: 0 24px;
  }
  .bar-hero-label {
    font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.65rem;
    font-weight: 700; letter-spacing: 0.3em; text-transform: uppercase;
    color: #D4AF37; display: block; margin-bottom: 20px;
  }
  .bar-hero-title {
    font-family: 'Noto Serif', serif; font-style: italic; font-weight: 700;
    font-size: clamp(3.5rem, 10vw, 8rem); letter-spacing: -0.03em; line-height: 1;
    color: #fcf9f8; margin: 0 0 16px;
  }
  .bar-hero-sub {
    font-family: 'Noto Serif', serif; font-style: italic;
    font-size: clamp(1.1rem, 2vw, 1.5rem); color: rgba(252,249,248,0.8);
    margin: 0;
  }

  /* Concept grid */
  .bar-concept-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 80px; align-items: center;
  }
  @media (max-width: 860px) { .bar-concept-grid { grid-template-columns: 1fr; gap: 48px; } }

  .bar-concept-photos {
    display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
  }
  .bar-concept-photo-a,
  .bar-concept-photo-b {
    overflow: hidden; position: relative; border-radius: 0.25rem;
  }
  .bar-concept-photo-a { aspect-ratio: 4/5; }
  .bar-concept-photo-b { aspect-ratio: 4/5; margin-top: 48px; }
  .bar-concept-photo-a img,
  .bar-concept-photo-b img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16,1,0.3,1);
    filter: saturate(0.85) contrast(1.02);
  }
  .bar-concept-photo-a:hover img,
  .bar-concept-photo-b:hover img { transform: scale(1.06); }
  .bar-concept-photo-label {
    position: absolute; bottom: 0; left: 0; right: 0;
    background: linear-gradient(0deg, rgba(0,47,33,0.75) 0%, transparent 100%);
    padding: 40px 16px 16px;
    font-family: 'Noto Serif', serif; font-style: italic; font-size: 1.2rem;
    color: #fcf9f8;
  }

  /* Ateliers bento */
  .ateliers-bento {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: auto auto;
    gap: 8px;
  }
  @media (max-width: 860px) { .ateliers-bento { grid-template-columns: 1fr; } }

  .atelier-card {
    border-radius: 0.25rem; overflow: hidden; position: relative;
    transition: box-shadow 0.4s;
  }
  .atelier-card:hover { box-shadow: 0 20px 56px rgba(0,0,0,0.3); }
  .atelier-content { padding: 32px; position: relative; z-index: 2; height: 100%; box-sizing: border-box; display: flex; flex-direction: column; }

  /* Large card with photo bg */
  .atelier-large {
    grid-row: 1; background: #003326; min-height: 280px;
  }
  .atelier-bg-img {
    position: absolute; right: 0; top: 0; height: 100%; width: 45%;
    object-fit: cover; opacity: 0.2;
    transition: opacity 0.4s;
  }
  .atelier-large:hover .atelier-bg-img { opacity: 0.35; }
  .atelier-list {
    list-style: none; padding: 0; margin: 20px 0 0;
    display: flex; flex-direction: column; gap: 8px;
  }
  .atelier-list li {
    font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.9rem;
    color: rgba(252,249,248,0.8); display: flex; align-items: center; gap: 10px;
  }
  .atelier-list li::before {
    content: '✓'; color: #D4AF37; font-weight: 700; font-size: 0.7rem;
  }

  /* Gold card */
  .atelier-gold {
    grid-column: 2; grid-row: 1 / 3; background: #D4AF37; min-height: 280px;
  }
  @media (max-width: 860px) { .atelier-gold { grid-column: 1; grid-row: auto; } }

  /* Small dark */
  .atelier-small-dark {
    grid-column: 1; grid-row: 2; background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
  }
  @media (max-width: 860px) { .atelier-small-dark { grid-column: 1; grid-row: auto; } }

  /* CTA wide */
  .atelier-cta {
    grid-column: 2 / 3; grid-row: 3;
    background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
    cursor: pointer;
  }
  @media (max-width: 860px) { .atelier-cta { grid-column: 1; grid-row: auto; } }
  /* Actually let me fix the grid layout */
  .atelier-cta {
    grid-column: 1 / -1;
  }
  .atelier-small-dark {
    grid-column: 1;
  }
  .atelier-gold {
    grid-column: 2; grid-row: 1 / 3;
  }

  /* Events timeline */
  .events-timeline {
    display: flex; flex-direction: column; gap: 72px;
  }
  .event-row {
    display: grid; grid-template-columns: 1fr 80px 1fr;
    gap: 40px; align-items: center;
  }
  .event-row-reverse .event-text { order: 3; text-align: left; }
  .event-row-reverse .event-dot { order: 2; }
  .event-row-reverse .event-photo { order: 1; }
  .event-row:not(.event-row-reverse) .event-text { text-align: right; }
  @media (max-width: 760px) {
    .event-row { grid-template-columns: 1fr; gap: 20px; }
    .event-row .event-text,
    .event-row-reverse .event-text { order: 2; text-align: left; }
    .event-row .event-dot,
    .event-row-reverse .event-dot { order: 1; }
    .event-row .event-photo,
    .event-row-reverse .event-photo { order: 3; }
  }

  .event-dot {
    display: flex; flex-direction: column; align-items: center; gap: 8px;
  }
  .event-dot-circle {
    width: 14px; height: 14px; border-radius: 50%; background: #D4AF37; flex-shrink: 0;
  }
  .event-dot-line {
    width: 1px; height: 48px; background: rgba(212,175,55,0.25);
  }
  .event-dot-icon {
    font-size: 1.2rem; color: #6e5d04;
  }
  .event-photo { overflow: hidden; border-radius: 0.25rem; }
  .event-photo-img {
    width: 100%; aspect-ratio: 16/9; object-fit: cover;
    filter: grayscale(0.6) contrast(1.02);
    transition: filter 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1);
  }
  .event-photo:hover .event-photo-img { filter: grayscale(0) contrast(1.04); transform: scale(1.03); }
</style>

<script>
  const els = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const obs = new IntersectionObserver(
      (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-in'); obs.unobserve(e.target); } }),
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );
    els.forEach(el => obs.observe(el));
  } else {
    els.forEach(el => el.classList.add('is-in'));
  }
</script>
