---
import Layout from '../layouts/Layout.astro';
import { reviews } from '../data/reviews';

const barMobileReviews = reviews.filter(r => r.product === 'Bar à Crêpes');

const events = [
  {
    title: 'Mariages',
    desc: 'Une touche de magie et de gourmandise pour votre vin d\'honneur ou votre soirée dansante.',
    icon: '♡',
    image: '/bar-cart.jpeg',
  },
  {
    title: 'Corporate',
    desc: 'Fédérez vos équipes autour d\'une animation culinaire lors de vos séminaires et lancements.',
    icon: '◈',
    image: '/mini-pancakes-box.jpeg',
  },
  {
    title: 'Soirées Privées',
    desc: 'Anniversaires, garden parties ou réceptions intimes : l\'excellence CooksBrad chez vous.',
    icon: '✦',
    image: '/mini-pancakes-plancha.jpeg',
  },
];
---

<Layout
  title="Bar mobile événementiel — Cooksbrad"
  description="Bar mobile événementiel CooksBrad : bars à crêpes, focaccia, cocktails et animations sur mesure pour mariages, corporate et soirées privées."
  current="bar-mobile"
>

  <!-- Hero -->
  <section class="bar-hero">
    <img
      class="bar-hero-img"
      src="/bar-cart.jpeg"
      width="778"
      height="778"
      alt="Bar Mobile CooksBrad — bar mobile événementiel"
      loading="eager"
      fetchpriority="high"
    />
    <div class="bar-hero-overlay"></div>

    <!-- Floating ornaments -->
    <div class="hero-orns" aria-hidden="true">
      <span class="hero-orn" style="--fs:1.3rem;--op:0.18;--dur:9s;--delay:0s;--travel:-16px;--rot:12deg;--scale:1.1;top:18%;left:8%">✦</span>
      <span class="hero-orn" style="--fs:0.8rem;--op:0.14;--dur:7s;--delay:1.5s;--travel:-12px;--rot:-8deg;--scale:1.07;top:28%;right:10%">✦</span>
      <span class="hero-orn" style="--fs:1.7rem;--op:0.10;--dur:11s;--delay:3s;--travel:-22px;--rot:7deg;--scale:1.04;bottom:25%;right:6%">✦</span>
    </div>

    <div class="bar-hero-content">
      <span class="bar-hero-label hero-animate hero-animate-0">CooksBrad Atelier</span>
      <div class="hero-title-wrap">
        <h1 class="bar-hero-title" style="animation: titleSlideUp 1.3s cubic-bezier(0.16,1,0.3,1) 0.32s forwards; opacity:0; transform:translateY(105%)">Bar Mobile</h1>
      </div>
      <p class="bar-hero-sub hero-animate hero-animate-2">Chic, élégant et gourmand</p>
      <div class="hero-animate hero-animate-3" style="margin-top:32px">
        <a href="/contact" class="btn btn-forest">
          Demander un devis <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Concept section -->
  <section class="section bg-cream">
    <div class="container">
      <div class="bar-concept-grid">
        <div class="reveal">
          <span class="eyebrow" style="display:block;margin-bottom:12px">L'Art de Recevoir</span>
          <h2 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:600;font-size:clamp(2rem,4vw,3.4rem);color:#1b1c1c;letter-spacing:-0.02em;line-height:1.1;margin-bottom:20px">
            Une Animation<br/>Culinaire sur Mesure
          </h2>
          <p class="body-text" style="margin-bottom:28px">
            CooksBrad réinvente l'animation de vos événements avec une solution mobile haut de gamme.
            Du bar à crêpes artisanal au bar à focaccia sophistiqué, notre atelier se déplace pour créer
            une expérience visuelle et gustative inoubliable.
          </p>
          <div style="display:flex;gap:24px;flex-wrap:wrap">
            <div style="display:flex;align-items:center;gap:8px">
              <span style="font-family:'Montserrat',sans-serif;font-size:0.65rem;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#1b1c1c">Mise en Scène Élégante</span>
            </div>
            <div style="display:flex;align-items:center;gap:8px">
              <span style="font-family:'Montserrat',sans-serif;font-size:0.65rem;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#1b1c1c">Ingrédients de Qualité</span>
            </div>
          </div>
        </div>
        <div class="bar-concept-photos reveal reveal-delay-1">
          <div class="bar-concept-photo-a">
            <img
              src="/mini-pancakes-plancha.jpeg"
              width="1024"
              height="1024"
              alt="Plancha mini pancakes CooksBrad"
              loading="lazy"
            />
            <div class="bar-concept-photo-label">Le Bar</div>
          </div>
          <div class="bar-concept-photo-b">
            <img
              src="/mini-pancakes-box.jpeg"
              width="1080"
              height="1080"
              alt="Box garnitures mini pancakes CooksBrad"
              loading="lazy"
            />
            <div class="bar-concept-photo-label">Les Toppings</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Ateliers signatures — bento on cream bg -->
  <section class="section bg-cream">
    <div class="container">
      <div style="text-align:center;margin-bottom:56px" class="reveal">
        <h2 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:700;font-size:clamp(2rem,4vw,3.4rem);color:#1b1c1c;letter-spacing:-0.02em;margin-bottom:8px">
          Nos Ateliers Signatures
        </h2>
        <p style="font-family:'Noto Serif',serif;font-style:italic;color:rgba(27, 28, 28,0.6);font-size:1rem">
          La précision du geste au service de la gourmandise.
        </p>
      </div>

      <div class="ateliers-bento reveal reveal-delay-1">
        <!-- Bar à Crêpes — large -->
        <div class="atelier-card atelier-large atelier-has-photo">
          <div class="atelier-photo-frame">
            <img
              src="/ateliers/bar-a-crepes.webp"
              width="1600"
              height="900"
              alt="Crêpes garnies, façon bar à crêpes CooksBrad"
              loading="lazy"
            />
          </div>
          <div class="atelier-content">
            <span style="font-family:'Montserrat',sans-serif;font-size:0.62rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#30804e;display:block;margin-bottom:12px">Tradition & Modernité</span>
            <h3 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:600;font-size:1.75rem;color:#1b1c1c;margin:0 0 12px">Bar à Crêpes</h3>
            <p style="font-family:'Montserrat',sans-serif;font-size:0.9rem;color:rgba(27, 28, 28,0.6);line-height:1.65;max-width:420px">
              Ingrédients soigneusement sélectionnés, garnitures maison et show-cooking. Une animation conviviale et gourmande préparée devant vos invités.
            </p>
            <ul class="atelier-list">
              <li>Caramel au beurre salé maison</li>
              <li>Fruits frais de saison</li>
              <li>Chocolat artisanal</li>
            </ul>
          </div>
        </div>

        <!-- Bar à focaccia — light -->
        <div class="atelier-card atelier-gold atelier-has-photo">
          <div class="atelier-photo-frame">
            <img
              src="/ateliers/bar-a-focaccia.webp"
              width="1600"
              height="900"
              alt="Focaccia artisanale aux tomates confites, façon bar à focaccia CooksBrad"
              loading="lazy"
            />
          </div>
          <div class="atelier-content">
            <span style="font-family:'Montserrat',sans-serif;font-size:0.62rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#30804e;display:block;margin-bottom:12px">L'Italie à l'Honneur</span>
            <h3 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:600;font-size:1.5rem;color:#1b1c1c;margin:0 0 12px">Bar à focaccia</h3>
            <p style="font-family:'Montserrat',sans-serif;font-size:0.88rem;color:rgba(27, 28, 28,0.6);line-height:1.65">
              Inspiré de l'art de vivre italien, notre bar à focaccia propose une expérience sur mesure autour de pains artisanaux généreux et de garnitures soigneusement sélectionnées. Une animation élégante qui transforme chaque réception en un véritable voyage gourmand.
            </p>
            <ul class="atelier-list">
              <li>Burrata crémeuse</li>
              <li>Bresaola de bœuf</li>
              <li>Pesto maison et légumes marinés</li>
            </ul>
          </div>
        </div>

        <!-- Le Bar Mobile — small light -->
        <div class="atelier-card atelier-small-dark atelier-has-photo">
          <div class="atelier-photo-frame">
            <img
              src="/ateliers/bar-rafraichissant.webp"
              width="1600"
              height="900"
              alt="Boisson rafraîchissante aux fruits frais et herbes aromatiques, façon bar rafraîchissant CooksBrad"
              loading="lazy"
            />
          </div>
          <div class="atelier-content">
            <span style="font-family:'Montserrat',sans-serif;font-size:0.62rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#30804e;display:block;margin-bottom:12px">Fraîcheur &amp; Légèreté</span>
            <h3 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:600;font-size:1.5rem;color:#1b1c1c;margin:0 0 12px">Bar rafraîchissant</h3>
            <p style="font-family:'Montserrat',sans-serif;font-size:0.85rem;color:rgba(27, 28, 28,0.6);line-height:1.6;margin:0 0 12px">Une expérience élégante autour de boissons préparées à la minute, imaginées pour offrir à vos invités un moment de fraîcheur et de partage.</p>
            <ul class="atelier-list">
              <li>Fruits frais sélectionnés</li>
              <li>Herbes aromatiques et garnitures raffinées</li>
              <li>Créations personnalisées selon votre événement</li>
            </ul>
          </div>
        </div>

        <!-- Sur mesure — wide -->
        <div class="atelier-card atelier-cta">
          <div class="atelier-content" style="display:flex;align-items:center;justify-content:space-between;gap:16px">
            <div>
              <h3 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:600;font-size:1.3rem;color:#1b1c1c;margin:0 0 6px">Créations Sur Mesure</h3>
              <p style="font-family:'Montserrat',sans-serif;font-size:0.85rem;color:rgba(27, 28, 28,0.6);margin:0">Un projet unique ? Nous créons le bar de vos rêves.</p>
            </div>
            <a href="/contact" style="display:flex;align-items:center;color:#0c392d;font-size:1.4rem;flex-shrink:0;transition:transform 0.25s;min-width:44px;min-height:44px;justify-content:center">→</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pour chaque moment — events timeline -->
  <section class="section bg-cream">
    <div class="container">
      <div style="text-align:center;margin-bottom:64px" class="reveal">
        <span class="eyebrow" style="display:block;margin-bottom:12px">Célébrations</span>
        <h2 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:600;font-size:clamp(2rem,4vw,3.4rem);color:#1b1c1c;letter-spacing:-0.02em">
          Pour Chaque Moment Unique
        </h2>
      </div>

      <div class="events-timeline">
        {events.map((ev, i) => (
          <div class={`event-row${i % 2 === 1 ? ' event-row-reverse' : ''} reveal`}>
            <div class="event-text">
              <h3 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:600;font-size:1.75rem;color:#1b1c1c;margin:0 0 12px">{ev.title}</h3>
              <p class="body-text" style="margin:0">{ev.desc}</p>
            </div>
            <div class="event-dot">
              <div class="event-dot-circle"></div>
              <div class="event-dot-line"></div>
              <span class="event-dot-icon">{ev.icon}</span>
            </div>
            <div class="event-photo">
              <img
                src={ev.image}
                width="1080"
                height="1080"
                alt={ev.title}
                loading="lazy"
                class="event-photo-img"
              />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Avis clients -->
  <section class="section bg-cream">
    <div class="container">
      <div style="text-align:center;margin-bottom:48px" class="reveal">
        <span class="eyebrow" style="display:block;margin-bottom:12px">Avis clients</span>
        <h2 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:600;font-size:clamp(2rem,4vw,3.4rem);color:#1b1c1c;letter-spacing:-0.02em">
          Ils ont vécu<br/>l'expérience Bar à Crêpes
        </h2>
      </div>
      <div style="display:flex;gap:24px;flex-wrap:wrap;justify-content:center">
        {barMobileReviews.map(r => (
          <article class="bk-review-card" style="flex:0 1 320px">
            <p class="bk-review-quote">« {r.quote} »</p>
            <footer class="bk-review-footer">
              <span class="bk-stars-gold" style="font-size:0.85rem">★★★★★</span>
              <strong class="bk-review-name">{r.name}</strong>
              <span class="bk-review-event">{r.event}</span>
              <span class="bk-review-product">{r.product}</span>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-band bg-forest">
    <div class="container reveal">
      <span class="eyebrow" style="display:block;margin-bottom:8px">Votre Événement</span>
      <h2>Prêt à sublimer<br/>votre événement ?</h2>
      <p class="body-text">
        Nous étudions chaque projet pour vous proposer une expérience sur mesure,
        adaptée à vos envies et à votre lieu, dans toute la région Provence-Alpes-Côte d'Azur
        (Bouches-du-Rhône, Var, Vaucluse, Alpes-Maritimes, Alpes-de-Haute-Provence, Hautes-Alpes).
      </p>
      <a href="/contact" class="btn btn-gold">
        Planifier mon événement <span class="arrow">→</span>
      </a>
    </div>
  </section>

</Layout>

<style>
  /* ─── Overflow guard ─── */
  :global(body) {
    overflow-x: hidden;
  }

  /* ─── Bar Hero ─── */
  .bar-hero {
    position: relative;
    height: 100svh;
    min-height: 540px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-top: 76px;
  }
  .bar-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(1.02) saturate(0.92);
    animation: hero-kenburns 22s ease-in-out infinite alternate;
  }
  .bar-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(247,245,239,0.40) 0%, rgba(247,245,239,0.60) 100%);
  }
  .bar-hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #0c392d;
    padding: 0 24px;
    width: 100%;
    max-width: 100%;
  }
  .bar-hero-label {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #30804e;
    display: block;
    margin-bottom: 20px;
  }
  .bar-hero-title {
    font-family: 'Alex Brush', cursive;
    font-style: normal;
    font-weight: 400;
    font-size: clamp(3.5rem, 14vw, 9rem);
    letter-spacing: 0.01em;
    line-height: 1.05;
    color: #0c392d;
    margin: 0 0 16px;
  }
  .bar-hero-sub {
    font-family: 'Noto Serif', serif;
    font-style: italic;
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    color: #1a5c3a;
    margin: 0;
    /* neutralise le `p { text-align: justify; text-align-last: left }` global.
       text-align-last est indispensable : sur un paragraphe d'une seule ligne,
       cette ligne est aussi la dernière, donc c'est elle qui l'emporte. */
    text-align: center;
    text-align-last: center;
  }

  /* ─── Concept grid ─── */
  .bar-concept-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  /* ─── Concept photos ─── */
  .bar-concept-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .bar-concept-photo-a,
  .bar-concept-photo-b {
    overflow: hidden;
    position: relative;
    border-radius: 0.25rem;
  }
  .bar-concept-photo-a { aspect-ratio: 4/5; }
  .bar-concept-photo-b { aspect-ratio: 4/5; margin-top: 48px; }

  .bar-concept-photo-a img,
  .bar-concept-photo-b img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16,1,0.3,1);
    filter: saturate(0.85) contrast(1.02);
  }
  .bar-concept-photo-a:hover img,
  .bar-concept-photo-b:hover img { transform: scale(1.06); }
  .bar-concept-photo-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(0deg, rgba(27, 28, 28,0.75) 0%, transparent 100%);
    padding: 40px 16px 16px;
    font-family: 'Noto Serif', serif;
    font-style: italic;
    font-size: 1.2rem;
    color: #f7f5ef;
  }

  /* ─── Ateliers bento ─── */
  .ateliers-bento {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: auto auto;
    gap: 8px;
  }

  .atelier-card {
    border-radius: 0.25rem;
    overflow: hidden;
    position: relative;
    transition: box-shadow 0.4s;
  }
  .atelier-card:hover { box-shadow: 0 16px 40px rgba(27, 28, 28,0.1); }

  .atelier-content {
    padding: 32px;
    position: relative;
    z-index: 2;
    height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  /* Large card with photo bg */
  .atelier-large {
    grid-row: 1;
    background: #ffffff;
    border: 1px solid rgba(27, 28, 28,0.12);
    min-height: 280px;
  }

  .atelier-list {
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .atelier-list li {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.9rem;
    color: rgba(27, 28, 28,0.78);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .atelier-list li::before {
    content: '✓';
    color: #30804e;
    font-weight: 700;
    font-size: 0.7rem;
  }

  /* Tiramisu card — light */
  .atelier-gold {
    grid-column: 2;
    grid-row: 1;
    background: #ffffff;
    border: 1px solid rgba(27, 28, 28,0.12);
    min-height: 280px;
  }

  /* Le Bar Mobile — light */
  .atelier-small-dark {
    grid-column: 1;
    grid-row: 2;
    background: #ffffff;
    border: 1px solid rgba(27, 28, 28,0.12);
  }

  /* CTA wide */
  .atelier-cta {
    grid-column: 2;
    grid-row: 2;
    background: #ffffff;
    border: 1px solid rgba(27, 28, 28,0.12);
    cursor: pointer;
  }

  /* Photo variant (Bar à Crêpes / Bar à focaccia) */
  .atelier-has-photo {
    display: flex;
    flex-direction: column;
  }
  .atelier-photo-frame {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    flex-shrink: 0;
  }
  .atelier-photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .atelier-has-photo .atelier-content {
    height: auto;
  }

  /* ─── Events timeline ─── */
  .events-timeline {
    display: flex;
    flex-direction: column;
    gap: 72px;
  }
  .event-row {
    display: grid;
    grid-template-columns: 1fr 80px 1fr;
    gap: 40px;
    align-items: center;
  }
  .event-row-reverse .event-text { order: 3; text-align: left; }
  .event-row-reverse .event-dot  { order: 2; }
  .event-row-reverse .event-photo { order: 1; }
  .event-row:not(.event-row-reverse) .event-text { text-align: right; }

  .event-dot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .event-dot-circle {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #ceb85c;
    flex-shrink: 0;
  }
  .event-dot-line {
    width: 1px;
    height: 48px;
    background: rgba(206,184,92,0.25);
  }
  .event-dot-icon {
    font-size: 1.2rem;
    color: #30804e;
  }
  .event-photo {
    overflow: hidden;
    border-radius: 0.25rem;
  }
  .event-photo-img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    filter: contrast(1.04) saturate(1.08) brightness(0.97);
    transition: filter 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1);
  }
  .event-photo:hover .event-photo-img {
    filter: contrast(1.07) saturate(1.15) brightness(0.98);
    transform: scale(1.03);
  }

  /* ═══════════════════════════════════════════
     MOBILE — tablette (≤860px)
  ═══════════════════════════════════════════ */
  @media (max-width: 860px) {
    /* Concept : 2 colonnes → 1 colonne */
    .bar-concept-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    /* Photos en side-by-side resserrées */
    .bar-concept-photos {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .bar-concept-photo-a,
    .bar-concept-photo-b {
      aspect-ratio: 3/2;
    }
    .bar-concept-photo-b {
      margin-top: 20px;
    }

    /* Bento : 1 colonne */
    .ateliers-bento {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }
    .atelier-large  { grid-column: 1; grid-row: auto; min-height: 220px; }
    .atelier-gold   { grid-column: 1; grid-row: auto; min-height: auto; }
    .atelier-small-dark { grid-column: 1; grid-row: auto; }
    .atelier-cta    { grid-column: 1; grid-row: auto; }

    /* Events : 1 colonne sans dot */
    .events-timeline { gap: 40px; }
    .event-row {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .event-row .event-text,
    .event-row-reverse .event-text { order: 2; text-align: left; }
    .event-dot { display: none; }
    .event-row .event-photo,
    .event-row-reverse .event-photo { order: 1; }
    .event-row .event-text,
    .event-row-reverse .event-text { order: 2; }
  }

  /* ═══════════════════════════════════════════
     MOBILE — iPhone (≤480px)
  ═══════════════════════════════════════════ */
  @media (max-width: 480px) {
    /* Hero */
    .bar-hero {
      min-height: 480px;
      margin-top: 60px;
    }
    .bar-hero-content {
      padding: 0 20px;
    }
    .bar-hero-label {
      font-size: 0.6rem;
