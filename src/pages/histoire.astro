---
import Layout from '../layouts/Layout.astro';

const values = [
  { num: '01', title: 'Fait Main', text: 'Chaque cookie est façonné à la main, avec attention et précision. Aucune machine, aucun surgelé.' },
  { num: '02', title: 'Ingrédients Locaux', text: 'La farine du moulin voisin, le beurre d\'origine contrôlée, le chocolat chez de petits producteurs.' },
  { num: '03', title: 'Sans Compromis', text: 'La qualité ne se négocie pas. Chaque fournée est testée avant d\'être servie.' },
];
---

<Layout
  title="Notre Histoire — La Maison"
  description="Dix ans à faire une seule chose, et à la faire bien."
  current="histoire"
  forestTop={true}
>

  <!-- Page banner -->
  <section class="page-banner">
    <div class="container page-banner-inner">
      <div>
        <div class="breadcrumbs">
          <a href="/">Maison</a>
          <span class="ornament" style="font-size:0.9rem">✦</span>
          <span style="color:#9C8870">Notre Histoire</span>
        </div>
        <h1>Dix ans à ne rien<br/>presser.</h1>
      </div>
      <p>
        Camille a quitté son métier en 2015 pour cuire des cookies.
        Depuis, rien n'a changé — une fournée par jour, à la main, sur commande.
      </p>
    </div>
  </section>

  <!-- Histoire — texte + photo -->
  <section class="section bg-cream">
    <div class="container">
      <div class="histoire-grid">
        <div class="histoire-image reveal">
          <div
            class="real-photo"
            style="background-image:url('https://images.unsplash.com/photo-1556909114-44e3e70034e2?w=1400&q=85&auto=format&fit=crop')"
          ></div>
          <span class="histoire-image-caption">Atelier · Rue de Turenne · 2025</span>
        </div>
        <div class="histoire-text reveal reveal-delay-1">
          <span class="eyebrow"><span style="color:#9C8870">N° 01</span> &nbsp;·&nbsp; Les Origines</span>
          <div class="timeline-dot-3d"></div>
          <p class="body-text" style="margin-bottom:18px">
            Tout a commencé dans une petite cuisine, avec une envie simple : créer des cookies qui racontent quelque chose.
            Pas des biscuits industriels, mais de vraies gourmandises, façonnées à la main, avec des ingrédients choisis avec soin.
          </p>
          <p class="body-text" style="margin-bottom:18px">
            Chaque recette est le fruit de nombreux essais, d'ajustements minutieux, d'un respect profond pour les saveurs.
            La farine vient du moulin voisin, le beurre est d'origine contrôlée, le chocolat est sélectionné chez de petits producteurs.
          </p>
          <p class="body-text">
            Aujourd'hui, notre passion se traduit en chaque cookie qui sort du four.
            Nous croyons que la gourmandise bien faite mérite du temps, de l'attention et beaucoup d'amour.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Valeurs -->
  <section class="section bg-forest">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left reveal">
          <span class="eyebrow" style="color:rgba(245,239,224,0.55)"><span style="color:#9C8870">N° 02</span> &nbsp;·&nbsp; Nos Valeurs</span>
          <hr class="hairline" />
          <h2 style="color:#F5EFE0">Trois règles,<br/>jamais enfreintes.</h2>
        </div>
        <p class="body-text reveal reveal-delay-1">
          Le luxe, pour nous, c'est le refus. Refus de la machine, refus de la quantité, refus du surgelé.
        </p>
      </div>
      <div class="values reveal">
        {values.map(v => (
          <div class="value-cell">
            <span class="value-num">{v.num}</span>
            <h3>{v.title}</h3>
            <p class="body-text">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Citation -->
  <section class="pull-quote bg-cream">
    <div class="container reveal">
      <span class="ornament" style="font-size:1.8rem;display:block;margin-bottom:24px">✦</span>
      <blockquote>
        « La gourmandise, quand elle est bien faite,<br/>
        devient un art de vivre. »
      </blockquote>
      <cite>— La Maison</cite>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-band bg-cream" style="border-top:1px solid rgba(28,58,42,0.1)">
    <div class="container reveal">
      <span class="eyebrow" style="color:#9C8870">Nos Créations</span>
      <h2>Découvrez ce qui sort<br/>du four chaque matin.</h2>
      <p class="body-text">
        Six recettes façonnées à la main, à partir de matières rares.
      </p>
      <a href="/creations" class="btn btn-primary">
        Voir nos créations <span class="arrow">→</span>
      </a>
    </div>
  </section>

</Layout>

<script>
  const els = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const obs = new IntersectionObserver(
      (entries) => entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('is-in'); obs.unobserve(e.target); }
      }),
      { threshold: 0.12, rootMargin: '0px 0px -60px 0px' }
    );
    els.forEach(el => obs.observe(el));
  } else {
    els.forEach(el => el.classList.add('is-in'));
  }
</script>
