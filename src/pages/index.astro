---
import Layout from '../layouts/Layout.astro';

const reviews = [
  {
    quote: "Une animation exceptionnelle qui a fait l'unanimité auprès de nos invités. Le bar à crêpes était un vrai succès !",
    name: "Sophie M.",
    event: "Mariage · Région PACA",
    product: "Bar à Crêpes",
  },
  {
    quote: "Le bar à tiramisu a été une vraie révélation : originalité, goût et élégance. Nos collaborateurs en parlent encore.",
    name: "Thomas & Julie",
    event: "Soirée corporate · Marseille",
    product: "Bar à Tiramisu",
  },
  {
    quote: "CooksBrad a su créer une ambiance unique, à la fois conviviale et haut de gamme. Je recommande sans hésiter.",
    name: "Camille R.",
    event: "Anniversaire privé · Aix-en-Provence",
    product: "Bar à Gaufres",
  },
  {
    quote: "Service irréprochable du début à la fin. Une équipe professionnelle et souriante qui a tout géré parfaitement.",
    name: "Marc D.",
    event: "EVJF · Nice",
    product: "Bar à Crêpes",
  },
];

const services = [
  {
    name: "Cookies Artisanaux",
    tag: "Des créations artisanales à déguster ou à offrir pour toutes les occasions.",
    badge: "Signature",
    href: "/creations",
    image: "/cookies-hero.jpeg",
  },
  {
    name: "Événement gourmand",
    tag: "Un bar mobile personnalisable qui s’adapte à vos envies pour rendre chaque événement unique.",
    badge: null,
    href: "/bar-mobile",
    image: "/mini-pancakes-plancha.jpeg",
  },
];

const events = [
  {
    title: "Mariages",
    body: "Une animation gourmande qui ravira petits et grands. Bar à crêpes ou tiramisu pour votre vin d'honneur ou soirée dansante.",
  },
  {
    title: "Anniversaires",
    body: "Pour célébrer vos moments importants avec originalité. Une expérience mémorable et conviviale pour tous vos invités.",
  },
  {
    title: "Entreprises",
    body: "Séminaires, inaugurations, soirées d'entreprise, journées clients : une animation culinaire prestige pour fédérer vos équipes.",
  },
  {
    title: "Événements Privés",
    body: "Baptêmes, baby showers, EVJF, fêtes familiales. Nous nous déplaçons sur votre lieu de réception en région PACA.",
  },
];
---

<Layout
  title="CooksBrad — Bar Mobile Événementiel · PACA"
  description="Bar mobile événementiel en région PACA : cookies artisanaux, bar à crêpes, bar à tiramisu — animations gourmandes pour mariages, corporate et soirées privées."
>

  <!-- ══════════════════════════════════════
       HERO
       ══════════════════════════════════════ -->
  <section class="bk-hero">
    <div class="bk-hero-media">
      <img
        src="/garden-party.jpeg"
        alt="CooksBrad — animation événementielle en région PACA"
        class="bk-hero-img"
        fetchpriority="high"
        loading="eager"
      />
    </div>
    <div class="bk-hero-body">
      <p class="bk-hero-eyebrow">PACA</p>
      <h1 class="bk-hero-title">
        L'art de sublimer<br/>
        chaque moment<br/>
        partagé.
      </h1>
      <p class="bk-hero-sub">
        Cookies artisanaux, bars gourmands et animations événementielles en région PACA.
      </p>
      <div class="bk-hero-actions">
        <a href="/contact" class="bk-hero-btn bk-hero-btn-primary">Demander un devis</a>
        <a href="#prestations" class="bk-hero-btn bk-hero-btn-secondary">Découvrir nos prestations</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       MARQUEE
       ══════════════════════════════════════ -->
  <div class="bk-marquee" aria-hidden="true">
    <div class="bk-marquee-track">
      <span class="bk-marquee-item">Bar Mobile PACA</span>
      <span class="bk-marquee-sep">✦</span>
      <span class="bk-marquee-item">Crêpes en direct</span>
      <span class="bk-marquee-sep">✦</span>
      <span class="bk-marquee-item">Bar à Gaufres</span>
      <span class="bk-marquee-sep">✦</span>
      <span class="bk-marquee-item">Bar à Tiramisu</span>
      <span class="bk-marquee-sep">✦</span>
      <span class="bk-marquee-sep">✦</span>
      <span class="bk-marquee-item">Sur Mesure</span>
      <span class="bk-marquee-sep">✦</span>
      <span class="bk-marquee-item">Mariages &amp; Événements</span>
      <span class="bk-marquee-sep">✦</span>
      <span class="bk-marquee-item">Produits Artisanaux</span>
      <span class="bk-marquee-sep">✦</span>
      <span class="bk-marquee-item">Bar Mobile PACA</span>
      <span class="bk-marquee-sep">✦</span>
      <span class="bk-marquee-item">Crêpes en direct</span>
      <span class="bk-marquee-sep">✦</span>
      <span class="bk-marquee-item">Bar à Gaufres</span>
      <span class="bk-marquee-sep">✦</span>
      <span class="bk-marquee-item">Bar à Tiramisu</span>
      <span class="bk-marquee-sep">✦</span>
      <span class="bk-marquee-sep">✦</span>
      <span class="bk-marquee-item">Sur Mesure</span>
      <span class="bk-marquee-sep">✦</span>
      <span class="bk-marquee-item">Mariages &amp; Événements</span>
      <span class="bk-marquee-sep">✦</span>
      <span class="bk-marquee-item">Produits Artisanaux</span>
      <span class="bk-marquee-sep">✦</span>
    </div>
  </div>

  <!-- ══════════════════════════════════════
       USP STRIP
       ══════════════════════════════════════ -->
  <div class="bk-usp-strip" aria-label="Nos engagements">
    <div class="bk-usp-inner">
      <span class="bk-usp-badge"><span class="bk-usp-dot">✦</span> Préparés sur place</span>
      <span class="bk-usp-badge"><span class="bk-usp-dot">✦</span> Ingrédients sélectionnés</span>
      <span class="bk-usp-badge"><span class="bk-usp-dot">✦</span> Région PACA</span>
      <span class="bk-usp-badge"><span class="bk-usp-dot">✦</span> Sur mesure</span>
    </div>
  </div>

  <!-- ══════════════════════════════════════
       AVIS
       ══════════════════════════════════════ -->
  <section class="bk-reviews">
    <div class="container bk-reviews-head reveal-up">
      <h2 class="bk-reviews-title">Ils nous ont<br/>fait confiance</h2>
      <p class="bk-reviews-meta">
        <span class="bk-stars-gold">★★★★★</span>
        <strong>4,9</strong>
      </p>
      <p style="font-family:'Montserrat',sans-serif;font-size:0.58rem;letter-spacing:0.14em;text-transform:uppercase;color:rgba(12, 57, 45,0.45);margin:6px 0 0">Satisfaction clients</p>
    </div>
    <div class="bk-carousel-outer">
      <div class="bk-carousel" role="list">
        {reviews.map(r => (
          <article class="bk-review-card" role="listitem">
            <p class="bk-review-quote">« {r.quote} »</p>
            <footer class="bk-review-footer">
              <span class="bk-stars-gold" style="font-size:0.85rem">★★★★★</span>
              <strong class="bk-review-name">{r.name}</strong>
              <span class="bk-review-event">{r.event}</span>
              <span class="bk-review-product">{r.product}</span>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       NOS PRESTATIONS
       ══════════════════════════════════════ -->
  <section id="prestations" class="bk-services">
    <div class="container">
      <div class="bk-services-head reveal-up">
        <h2 class="bk-services-title">Deux univers, une même passion</h2>
        <p class="bk-services-sub">Chez CooksBrad, nous partageons notre amour de la gourmandise à travers deux expériences uniques.</p>
      </div>
      <div class="bk-prod-grid bk-prod-grid--duo">
        {services.map(s => (
          <a href={s.href} class="bk-prod-card">
            <figure class="bk-prod-photo">
              {s.badge && <span class="bk-prod-badge">{s.badge}</span>}
              <span class="bk-prod-arrow" aria-hidden="true">→</span>
              <img src={s.image} alt={s.name} loading="lazy" />
            </figure>
            <div class="bk-prod-info">
              <h3 class="bk-prod-name">{s.name}</h3>
              <p class="bk-prod-tag">{s.tag}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="bk-services-cta">
        <a href="/contact" class="bk-services-link">Demander un devis gratuit →</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       PULL QUOTE
       ══════════════════════════════════════ -->
  <div class="bk-pull">
    <div class="bk-pull-inner reveal-up">
      <span class="bk-pull-mark">"</span>
      <blockquote class="bk-pull-quote">
        Chaque événement mérite<br/>un moment gourmand partagé.
      </blockquote>
      <cite class="bk-pull-cite">CooksBrad</cite>
    </div>
  </div>

  <!-- ══════════════════════════════════════
       QUI SOMMES-NOUS
       ══════════════════════════════════════ -->
  <section class="bk-story">
    <div class="bk-story-left">
      <span class="eyebrow" style="display:block;margin-bottom:18px">Qui sommes-nous ?</span>
      <h2 class="bk-story-title">CooksBrad</h2>
      <p class="bk-story-body">
        Chez CooksBrad, nous transformons chaque événement en un moment gourmand et convivial.
        Notre concept de bar mobile permet à vos invités de profiter de desserts préparés sur place
        et personnalisés selon leurs envies.
      </p>
      <p class="bk-story-body">
        Mariages, anniversaires, baptêmes, baby showers, événements professionnels ou soirées privées :
        nous nous déplaçons directement sur votre lieu de réception pour offrir une expérience unique.
        Notre objectif est simple : créer des souvenirs autour de la gourmandise.
      </p>
      <a href="/histoire" class="dual-link" style="margin-top:36px;display:inline-flex;align-items:center;gap:8px">
        Découvrir notre histoire →
      </a>
    </div>
    <div class="bk-story-right">
      <img
        src="/cookies-grilles.jpeg"
        alt="CooksBrad cookies artisanaux en production"
        class="bk-story-img"
        loading="lazy"
      />
    </div>
  </section>

  <!-- ══════════════════════════════════════
       POURQUOI NOUS CHOISIR
       ══════════════════════════════════════ -->
  <section class="section bg-cream">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left">
          <span class="eyebrow"><span style="color:#ceb85c">Nos engagements</span></span>
          <hr class="hairline" />
          <h2>Pourquoi choisir<br/>CooksBrad ?</h2>
        </div>
        <p class="body-text">
          Un service clé en main, professionnel et personnalisé, pour que vous puissiez profiter pleinement de votre événement.
        </p>
      </div>
      <div class="why-grid">
        {[
          "Produits préparés sur place",
          "Ingrédients sélectionnés avec soin",
          "Service professionnel et convivial",
          "Installation rapide",
          "Prestation personnalisable",
          "Déplacement sur votre lieu de réception",
        ].map(item => (
          <div class="why-item">
            <span class="why-dot">✦</span>
            <span>{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       CTA FINAL
       ══════════════════════════════════════ -->
  <section class="bk-cta bg-cream" style="border-top:1px solid rgba(12,57,45,0.08)">
    <div class="container" style="text-align:center">
      <span class="eyebrow" style="color:rgba(12,57,45,0.45);display:block;margin-bottom:16px">Organisons votre événement</span>
      <h2 class="bk-cta-title" style="color:#1b1c1c">
        Votre événement mérite<br/>une animation mémorable.
      </h2>
      <p class="bk-cta-sub" style="color:rgba(27,28,28,0.65)">
        Contactez-nous pour obtenir un devis gratuit adapté à votre projet.
      </p>
      <a href="/contact" class="btn btn-primary" style="border-radius:0.125rem">
        Recevoir mon devis gratuit →
      </a>
    </div>
  </section>

</Layout>

<style>
  /* ── Why grid ─────────────────────────────────────────────── */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 48px;
  }
  @media (max-width: 760px) {
    .why-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .why-grid { grid-template-columns: 1fr; }
  }
  .why-item {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.875rem;
    color: #0c392d;
    padding: 18px 20px;
    background: rgba(12, 57, 45,0.04);
    border-left: 2px solid #ceb85c;
    line-height: 1.5;
  }
  .why-dot {
    color: #ceb85c;
    font-size: 0.8rem;
    flex-shrink: 0;
  }

  /* ── bk-prod-grid duo variant (2 cards) ───────────────────── */
  .bk-prod-grid--duo {
    grid-template-columns: repeat(2, 1fr);
  }

  /* ══════════════════════════════════════════════════════════
     MOBILE FIXES — iPhone (≤ 640px)
     ══════════════════════════════════════════════════════════ */
  @media (max-width: 640px) {

    /* Prevent horizontal scroll from any overflowing child */
    html, body {
      overflow-x: hidden;
    }

    /* ── Hero ──────────────────────────────────────────────── */
    .bk-hero-body {
      /* Reduce lateral padding so title doesn't crowd the edges */
      padding: 5rem 1.25rem 2.5rem;
    }
    .bk-hero-eyebrow {
      /* Cap eyebrow so it doesn't look oversized at small sizes */
      font-size: 0.62rem;
      letter-spacing: 0.18em;
      margin-bottom: 14px;
    }
    .bk-hero-title {
      /* Comfortable readable size on 390px — 13vw ≈ 50px (fine),
         but clamp floor raised to ensure minimum readability */
      font-size: clamp(2.6rem, 13vw, 4rem);
      line-height: 1.08;
      margin-bottom: 28px;
      max-width: 100%;
    }
    .bk-hero-sub {
      font-size: 0.95rem;
      line-height: 1.6;
      max-width: 23rem;
      margin: -10px 0 24px;
    }
    .bk-hero-actions {
      width: 100%;
      gap: 10px;
      flex-direction: column;
      align-items: flex-start;
    }
    .bk-hero-btn {
      /* Touch target: ensure at least 44px height */
      min-height: 44px;
      padding: 13px 20px;
      font-size: 0.68rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      max-width: 340px;
      text-align: center;
    }

    /* ── Marquee — prevent horizontal bleed ────────────────── */
    .bk-marquee {
      overflow: hidden;
      width: 100%;
    }

    /* ── USP strip — wrap badges on small screens ──────────── */
    .bk-usp-strip {
      padding: 18px 1rem;
    }
    .bk-usp-inner {
      flex-wrap: wrap;
      gap: 8px;
    }
    .bk-usp-badge {
      font-size: 0.62rem;
      padding: 8px 12px;
    }

    /* ── Reviews carousel ──────────────────────────────────── */
    .bk-reviews {
      padding: 2.5rem 0 2rem;
    }
    .bk-reviews-head {
      padding: 0 1.25rem;
    }
    .bk-reviews-title {
      font-size: clamp(2rem, 11vw, 3rem);
    }
    .bk-carousel {
      /* Ensure cards don't overflow — 85vw gives a peek of next card */
      padding: 0 1.25rem 14px;
    }
    .bk-review-card {
      flex: 0 0 min(280px, 85vw);
      padding: 22px 20px 18px;
    }
    .bk-review-quote {
      font-size: 0.95rem;
      line-height: 1.65;
    }

    /* ── Services grid — 1 column for 2-card layout ───────── */
    .bk-prod-grid--duo {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    /* Standard prod-grid also goes 1-col on very small */
    .bk-prod-grid {
      grid-template-columns: 1fr !important;
      gap: 16px;
    }
    .bk-services-title {
      font-size: clamp(2.4rem, 12vw, 3.5rem);
    }
    .bk-services-sub {
      font-size: 0.9rem;
      padding: 0 0.5rem;
    }
    .bk-services-link {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      padding-bottom: 4px;
    }

    /* ── Pull quote ────────────────────────────────────────── */
    .bk-pull {
      padding: 3rem 1.25rem;
    }
    .bk-pull-quote {
      font-size: clamp(1.9rem, 9vw, 3rem);
    }
    .bk-pull-mark {
      font-size: clamp(3rem, 14vw, 5rem);
    }

    /* ── Brand story ───────────────────────────────────────── */
    .bk-story {
      grid-template-columns: 1fr;
    }
    .bk-story-left {
      padding: 2.5rem 1.25rem;
    }
    .bk-story-title {
      font-size: clamp(3rem, 16vw, 5rem);
    }
    .bk-story-body {
      font-size: 0.9rem;
    }

    /* ── Why / engagements section ─────────────────────────── */
    .section {
      padding: 3rem 0;
    }
    .section-head {
      margin-bottom: 32px;
      gap: 14px;
    }

    /* ── Events accordion ──────────────────────────────────── */
    .bk-events {
      grid-template-columns: 1fr;
      min-height: unset;
    }
    .bk-events-left {
      /* Reduce side padding drastically on 390px */
      padding: 2.5rem 1.25rem 1.5rem;
    }
    .bk-events-title {
      font-size: clamp(2.6rem, 13vw, 4rem);
    }
    .bk-events-sub {
      font-size: 0.88rem;
    }
    .bk-events-center {
      min-height: 220px;
    }
    .bk-events-right {
      padding: 1.5rem 1.25rem;
      border-left: none;
      border-top: 1px solid rgba(12, 57, 45,0.08);
    }
    .bk-accord-sum {
      padding: 16px 0;
      font-size: 0.95rem;
    }
    .bk-accord-body {
      font-size: 0.875rem;
      line-height: 1.65;
    }

    /* ── CTA final ─────────────────────────────────────────── */
    .bk-cta {
      padding: 3rem 0 2.5rem;
    }
    .bk-cta-title {
      font-size: clamp(2.4rem, 11vw, 4rem);
    }
    .bk-cta-sub {
      font-size: 0.9rem;
      padding: 0 1rem;
    }
    /* .btn / .btn-gold touch target */
    .btn {
      min-height: 44px;
      padding: 13px 28px;
      font-size: 0.68rem;
    }
  }

  /* ── Slightly wider phones (641–768px): 2 columns preserved ─ */
  @media (min-width: 641px) and (max-width: 900px) {
    .bk-prod-grid--duo {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
