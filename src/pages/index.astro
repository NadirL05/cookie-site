---
import Layout from '../layouts/Layout.astro';

const reviews = [
  {
    quote: "Un bar à crêpes absolument magique pour notre mariage. Les invités en parlent encore ! Le service était impeccable.",
    name: "Sophie M.",
    event: "Mariage · Région Parisienne",
    product: "Bar à Crêpes",
  },
  {
    quote: "Le bar à tiramisu a été un vrai succès — originalité, goût et élégance au rendez-vous. Nos collaborateurs ont adoré.",
    name: "Thomas & Julie",
    event: "Soirée corporate · Paris 8e",
    product: "Bar à Tiramisu",
  },
  {
    quote: "CooksBrad a su créer une ambiance unique, à la fois conviviale et haut de gamme. Je recommande sans hésiter.",
    name: "Camille R.",
    event: "Anniversaire privé · Neuilly",
    product: "Bar à Crêpes",
  },
  {
    quote: "Service irréprochable du début à la fin. Le bar cart a transformé notre séminaire en vrai moment de partage.",
    name: "Marc D.",
    event: "Corporate · La Défense",
    product: "Le Bar Cart",
  },
];

const ateliers = [
  {
    id: "crepes",
    label: "Bar à Crêpes",
    subtitle: "La tradition réinventée",
    desc: "Farine de blé noir bio, garnitures maison et show-cooking en direct devant vos invités. Une animation conviviale qui sublime le patrimoine avec une touche contemporaine.",
    features: ["Caramel au beurre salé maison", "Fruits frais de saison", "Chocolat artisanal", "Show-cooking inclus"],
    image: "https://images.unsplash.com/photo-1565299507177-b0ac66763828?w=900&q=80&auto=format&fit=crop",
  },
  {
    id: "tiramisu",
    label: "Bar à Tiramisu",
    subtitle: "L'Italie à l'honneur",
    desc: "Personnalisation en direct : choisissez votre biscuit, votre crème et vos toppings pour un dessert sur-mesure qui marquera les esprits de tous vos invités.",
    features: ["Mascarpone artisanal", "Biscuits signature", "Toppings au choix", "Version végane disponible"],
    image: "https://images.unsplash.com/photo-1571877227200-a0d98ea607e9?w=900&q=80&auto=format&fit=crop",
  },
  {
    id: "barcart",
    label: "Le Bar Cart",
    subtitle: "L'élégance mobile",
    desc: "Pour vos cocktails et boissons fines. Un bar sur roues habillé avec soin, verrerie cristal incluse. L'option parfaite pour les réceptions les plus sophistiquées.",
    features: ["Verrerie cristal incluse", "Mise en scène élégante", "Cocktails signature", "Sans alcool disponible"],
    image: "https://images.unsplash.com/photo-1551538827-9c037cb4f32a?w=900&q=80&auto=format&fit=crop",
  },
];

const events = [
  {
    title: "Mariages",
    body: "Bar à crêpes ou tiramisu pour votre vin d'honneur ou soirée dansante. Une touche de magie et de gourmandise pour ce jour inoubliable.",
  },
  {
    title: "Corporate",
    body: "Séminaires, team buildings, lancements produit — une animation culinaire prestige pour fédérer vos équipes autour d'une expérience mémorable.",
  },
  {
    title: "Soirées Privées",
    body: "Anniversaires, garden parties, réceptions intimes — l'excellence CooksBrad directement chez vous, partout en Île-de-France.",
  },
  {
    title: "Sur Mesure",
    body: "Un projet unique ? Nous créons le bar de vos rêves, adapté à votre lieu, votre univers et votre nombre d'invités.",
  },
];
---

<Layout title="CooksBrad — Bar Mobile Événementiel · Paris">

  <!-- ══════════════════════════════════════
       1. HERO — texte bas-gauche (Brooki)
       ══════════════════════════════════════ -->
  <section class="bk-hero">
    <div class="bk-hero-media">
      <img
        src="https://images.unsplash.com/photo-1536935338788-846bb9981813?w=1800&q=80&auto=format&fit=crop"
        alt="CooksBrad bar mobile événementiel Paris"
        class="bk-hero-img"
        fetchpriority="high"
        loading="eager"
      />
    </div>
    <div class="bk-hero-body">
      <p class="bk-hero-eyebrow">— Paris · Depuis MMXV —</p>
      <h1 class="bk-hero-title">
        le bar<br/>
        qui fait<br/>
        l'événement.
      </h1>
      <a href="/contact" class="bk-hero-btn">Réserver mon atelier →</a>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       2. AVIS — heading centré + carousel
       ══════════════════════════════════════ -->
  <section class="bk-reviews">
    <div class="container bk-reviews-head">
      <h2 class="bk-reviews-title">Le bar mobile<br/>préféré de Paris</h2>
      <p class="bk-reviews-meta">
        <span class="bk-stars-gold">★★★★★</span>
        <strong>4,9</strong>
        <span class="bk-reviews-count">(200+ événements)</span>
      </p>
    </div>
    <div class="bk-carousel-outer">
      <div class="bk-carousel" role="list">
        {reviews.map(r => (
          <article class="bk-review-card" role="listitem">
            <p class="bk-review-quote">« {r.quote} »</p>
            <footer class="bk-review-footer">
              <span class="bk-stars-gold" style="font-size:0.85rem">★★★★★</span>
              <strong class="bk-review-name">{r.name}</strong>
              <span class="bk-review-event">{r.event}</span>
              <span class="bk-review-product">{r.product}</span>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       3. ATELIERS — tabs CSS (Brooki)
       ══════════════════════════════════════ -->
  <section class="bk-ateliers">
    <div class="container bk-ateliers-wrap">
      <input type="radio" name="atelier" id="tab-crepes"   class="bk-tab-radio" checked />
      <input type="radio" name="atelier" id="tab-tiramisu" class="bk-tab-radio" />
      <input type="radio" name="atelier" id="tab-barcart"  class="bk-tab-radio" />

      <nav class="bk-tab-nav" aria-label="Nos ateliers">
        <label for="tab-crepes"   class="bk-tab-lbl">Bar à Crêpes</label>
        <label for="tab-tiramisu" class="bk-tab-lbl">Bar à Tiramisu</label>
        <label for="tab-barcart"  class="bk-tab-lbl">Le Bar Cart</label>
      </nav>

      <div class="bk-panels">
        {ateliers.map(a => (
          <div class={`bk-panel bk-panel-${a.id}`}>
            <div class="bk-panel-grid">
              <figure class="bk-panel-fig">
                <img src={a.image} alt={a.label} class="bk-panel-img" loading="lazy" />
              </figure>
              <div class="bk-panel-text">
                <span class="eyebrow" style="display:block;margin-bottom:14px">{a.label}</span>
                <h3 class="bk-panel-title">{a.subtitle}</h3>
                <p class="body-text" style="margin-bottom:20px">{a.desc}</p>
                <ul class="bk-feat-list">
                  {a.features.map(f => <li>{f}</li>)}
                </ul>
                <a href="/contact" class="btn btn-primary" style="margin-top:36px;display:inline-block">
                  Réserver cet atelier →
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       4. BRAND STORY — 50/50 split (Brooki)
       ══════════════════════════════════════ -->
  <section class="bk-story">
    <div class="bk-story-left">
      <span class="eyebrow" style="display:block;margin-bottom:18px">Notre Histoire</span>
      <h2 class="bk-story-title">CooksBrad</h2>
      <p class="bk-story-body">
        Depuis 2015, Brad sillonne Paris et la région pour apporter une expérience
        culinaire unique à vos événements. Une passion pour l'artisanat, un œil pour le
        détail, et l'obsession de créer des moments inoubliables.
      </p>
      <p class="bk-story-body">
        Chaque atelier est pensé comme une performance — show-cooking en direct,
        mise en scène élégante, produits sourcés avec soin.
      </p>
      <a href="/bar-mobile" class="dual-link" style="margin-top:36px;display:inline-flex;align-items:center;gap:8px">
        Découvrir nos ateliers →
      </a>
    </div>
    <div class="bk-story-right">
      <img
        src="https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=900&q=80&auto=format&fit=crop"
        alt="CooksBrad en action"
        class="bk-story-img"
        loading="lazy"
      />
    </div>
  </section>

  <!-- ══════════════════════════════════════
       5. ÉVÉNEMENTS — heading + photo + accordion (Brooki "Visit our stores")
       ══════════════════════════════════════ -->
  <section class="bk-events">
    <div class="bk-events-left">
      <h2 class="bk-events-title">Vos<br/>célébrations</h2>
      <p class="bk-events-sub">
        Chaque événement est unique.<br/>Nous nous adaptons à votre univers.
      </p>
      <a href="/contact" class="dual-link" style="margin-top:32px;display:inline-flex;align-items:center;gap:8px">
        Planifier mon événement →
      </a>
    </div>
    <div class="bk-events-center">
      <img
        src="https://images.unsplash.com/photo-1519741497674-611481863552?w=900&q=80&auto=format&fit=crop"
        alt="Mariage CooksBrad"
        class="bk-events-photo"
        loading="lazy"
      />
    </div>
    <div class="bk-events-right">
      {events.map((ev, i) => (
        <details class="bk-accord" open={i === 0}>
          <summary class="bk-accord-sum">
            <span>{ev.title}</span>
            <span class="bk-accord-icon"></span>
          </summary>
          <p class="bk-accord-body">{ev.body}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════
       6. CTA FINAL
       ══════════════════════════════════════ -->
  <section class="bk-cta bg-forest">
    <div class="container" style="text-align:center">
      <span class="eyebrow" style="color:rgba(252,249,248,0.45);display:block;margin-bottom:16px">Planifier</span>
      <h2 class="bk-cta-title">
        Votre événement mérite<br/>mieux que l'ordinaire.
      </h2>
      <p class="bk-cta-sub">
        Notre équipe étudie chaque projet pour vous proposer une expérience sur mesure.
      </p>
      <a href="/contact" class="btn btn-gold">
        Planifier mon événement →
      </a>
    </div>
  </section>

</Layout>
