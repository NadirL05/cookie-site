---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page introuvable — CooksBrad"
  description="Cette page n'existe pas. Retrouvez le bar mobile événementiel et les cookies artisanaux CooksBrad."
  current=""
  noindex={true}
>
  <section class="page-banner">
    <div class="container page-banner-inner">
      <div>
        <div class="breadcrumbs">
          <a href="/">Maison</a>
          <span style="color:#ceb85c;font-family:'Noto Serif',serif">✦</span>
          <span style="color:#ceb85c">Erreur 404</span>
        </div>
        <h1>Page<br/>introuvable.</h1>
      </div>
      <div>
        <p>
          La page que vous cherchez n'existe pas ou a été déplacée. Retrouvez nos
          prestations ou contactez-nous pour votre prochain événement.
        </p>
        <p>
          <a href="/" class="btn btn-gold">Retour à l'accueil</a>
          <a href="/contact/" class="btn btn-primary">Demander un devis</a>
        </p>
      </div>
    </div>
  </section>
</Layout>
