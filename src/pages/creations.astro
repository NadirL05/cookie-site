---
import Layout from '../layouts/Layout.astro';

const cookies = [
  { name: "Chocolat noir & fleur de sel", price: "3,50\u00a0€", badge: "Best seller", image: "/cookies/chocolat-noir-fleur-de-sel.webp" },
  { name: "Chocolat au lait", price: "3,50\u00a0€", badge: null, image: "/cookies/chocolat-au-lait.webp" },
  { name: "Trois chocolats", price: "3,50\u00a0€", badge: null, image: "/cookies/trois-chocolats.webp" },
  { name: "Spéculoos", price: "3,50\u00a0€", badge: null, image: "/cookies/speculoos.webp" },
  { name: "Pistache", price: "3,60\u00a0€", badge: "Nouveauté", image: "/cookies/pistache.webp" },
  { name: "Praliné noisette", price: "3,60\u00a0€", badge: null, image: "/cookies/praline-noisette.webp" },
  { name: "Chocolat blanc & noix de macadamia", price: "3,60\u00a0€", badge: null, image: "/cookies/chocolat-blanc-macadamia.webp" },
  { name: "Caramel, fleur de sel & cacahuète", price: "3,60\u00a0€", badge: "Édition limitée", image: "/cookies/caramel-cacahuete.webp" },
  { name: "Mini-boîte personnalisable", sub: "Boîte de 50 mini-cookies", price: "35\u00a0€", badge: null, image: "/cookies/mini-boite.webp", fit: "cover" },
];

const collections = [
  "Collection de Noël",
  "Collection Saint-Valentin",
  "Collection de Pâques",
  "Collection Halloween",
  "Éditions spéciales été",
];

const commandes = [
  "Anniversaires",
  "Mariages",
  "Événements professionnels",
  "Cadeaux gourmands",
  "Réunions familiales",
];
---

<Layout
  title="Nos Créations — Cooksbrad"
  description="Découvrez nos cookies artisanaux : incontournables, collections saisonnières et commandes personnalisées."
  current="creations"
>

  <!-- Page banner -->
  <section class="page-banner">
    <div class="container page-banner-inner">
      <div>
        <div class="breadcrumbs">
          <a href="/">Maison</a>
          <span style="color:#ceb85c;font-family:'Noto Serif',serif">✦</span>
          <span style="color:#ceb85c">Nos Créations</span>
        </div>
        <h1>Des créations<br/>gourmandes.</h1>
      </div>
      <div>
        <p style="text-align:justify">
          Chez CooksBrad, nous imaginons des créations gourmandes qui allient
          simplicité, qualité et générosité.
        </p>
        <div style="margin-top:28px">
          <a href="/contact" class="btn btn-primary">Commander mes cookies →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Nos incontournables -->
  <section class="section bg-cream">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left reveal">
          <span class="eyebrow"><span style="color:#ceb85c">N° 01</span> &nbsp;·&nbsp; Nos Incontournables</span>
          <hr class="hairline" />
          <h2>Notre carte<br/>de cookies.</h2>
        </div>
        <p class="body-text reveal reveal-delay-1">
          Préparés de manière artisanale, nos cookies sont généreux, moelleux à cœur
          et légèrement croustillants à l'extérieur. Des recettes gourmandes qui plaisent
          aussi bien aux petits qu'aux grands.
        </p>
      </div>

      <div class="cookie-shop">
        {cookies.map((c, i) => (
          <article class={`cookie-prod reveal${i > 0 ? " reveal-delay-" + Math.min(i, 3) : ""}`}>
            <div class={`cookie-prod-photo${c.fit === "cover" ? " cookie-prod-photo--cover" : ""}`}>
              {c.badge && (
                <span class={`cookie-prod-badge cookie-prod-badge--${c.badge === "Best seller" ? "best" : c.badge === "Nouveauté" ? "new" : "limited"}`}>{c.badge}</span>
              )}
              <img src={c.image} alt={`Cookie ${c.name}`} loading="lazy" />
            </div>
            <div class="cookie-prod-info">
              <h3 class="cookie-prod-name">{c.name}</h3>
              {c.sub && <span class="cookie-prod-sub">{c.sub}</span>}
              <span class="cookie-prod-price">{c.price}</span>
            </div>
          </article>
        ))}
      </div>

      <div class="cookie-tip reveal reveal-delay-2">
        <span class="cookie-tip-mark" aria-hidden="true">✦</span>
        <div>
          <h3 class="cookie-tip-title">Pour une dégustation réussie…</h3>
          <p class="cookie-tip-text">
            Conservez-les dans leur emballage d'origine, bien fermé, à température ambiante,
            pour préserver toute la fraîcheur et la gourmandise de vos cookies. Ils se dégustent
            idéalement jusqu'à 5 jours après réception de votre commande. Pour une expérience
            encore plus fondante, réchauffez-les délicatement 5 minutes à 100 °C dans un
            four à chaleur tournante.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Collections saisonnières -->
  <section class="section bg-forest">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left reveal">
          <span class="eyebrow"><span style="color:#ceb85c">N° 02</span> &nbsp;—&nbsp; Éditions limitées</span>
          <hr class="hairline" style="background:#ceb85c;opacity:0.4" />
          <h2 style="color:#f7f5ef">Les collections<br/>saisonnières.</h2>
        </div>
        <p class="body-text reveal reveal-delay-1" style="color:rgba(247,245,239,0.75)">
          Parce que chaque saison inspire de nouvelles créations, Cooksbrad imagine des
          collections éphémères aux saveurs raffinées. Chaque édition est pensée pour
          célébrer les plus beaux moments de l'année, avec des recettes exclusives et
          une présentation soignée.
        </p>
      </div>

      <div class="collections-grid">
        {collections.map((label, i) => (
          <div class={`collection-item reveal${i > 0 ? " reveal-delay-" + Math.min(i, 3) : ""}`}>
            <span class="collection-mark" aria-hidden="true">✦</span>
            <span class="collection-label">{label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Vente sur commande -->
  <section class="section bg-cream">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left reveal">
          <span class="eyebrow"><span style="color:#ceb85c">N° 03</span> &nbsp;—&nbsp; Commandes personnalisées</span>
          <hr class="hairline" />
          <h2>Commandes<br/>sur mesure.</h2>
        </div>
        <p class="body-text reveal reveal-delay-1">
          Qu'il s'agisse d'une réception intime ou d'un événement d'envergure, nos créations
          sont réalisées sur commande afin de s'adapter à vos envies, au nombre de convives
          et à l'univers de votre événement. Chaque commande est préparée avec le plus grand
          soin pour offrir une expérience aussi élégante que gourmande.
        </p>
      </div>

      <div class="commandes-grid">
        {commandes.map((label, i) => (
          <div class={`commande-item reveal${i > 0 ? " reveal-delay-" + Math.min(i, 3) : ""}`}>
            <span class="commande-mark" aria-hidden="true">✦</span>
            <span class="commande-label">{label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Fabrication artisanale -->
  <section class="pull-quote pull-quote-glass" style="border-top:1px solid rgba(12, 57, 45,0.08)">
    <div class="container reveal">
      <span style="font-family:'Noto Serif',serif;font-style:italic;color:#ceb85c;font-size:1.8rem;display:block;margin-bottom:20px">✦</span>
      <blockquote>
        « Une fabrication artisanale, des ingrédients sélectionnés,<br/>
        et une seule ambition : créer des moments de plaisir et de partage. »
      </blockquote>
      <cite>CooksBrad</cite>
    </div>
  </section>

  <!-- Retrouvez-nous -->
  <section class="section bg-forest" style="padding-top:0">
    <div class="container">
      <div class="cookie-presence reveal">
        <h3>Retrouvez-nous</h3>
        <p class="body-text">
          Nos cookies sont disponibles sur les marchés, lors d'événements privés et
          professionnels, au sein de notre bar mobile gourmand ainsi que sur commande
          tout au long de l'année.
        </p>
      </div>
    </div>
  </section>


  <!-- CTA -->
  <section class="cta-band bg-cream" style="border-top:1px solid rgba(12, 57, 45,0.08)">
    <div class="container reveal">
      <span class="eyebrow" style="color:#30804e;display:block;margin-bottom:8px">Commander</span>
      <h2>Passez votre commande.</h2>
      <p class="body-text">
        Commande personnalisée, devis événementiel ou renseignement : contactez-nous.
      </p>
      <a href="/contact" class="btn btn-primary">
        Nous contacter <span class="arrow">→</span>
      </a>
    </div>
  </section>

</Layout>

<style>
  /* ============================================================
     Page banner — corrections mobile
     ============================================================ */
  @media (max-width: 600px) {
    .page-banner {
      padding: 56px 0 40px;
    }
    .page-banner h1 {
      font-size: clamp(2.2rem, 10vw, 3.5rem);
      margin-top: 8px;
    }
    .page-banner p {
      font-size: 0.9rem;
      max-width: 100%;
    }
    .page-banner-inner {
      gap: 16px;
    }
  }

  /* ============================================================
     Carte cookies — grille boutique (façon krokme)
     ============================================================ */
  .cookie-shop {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 28px;
    margin-top: 56px;
  }
  @media (max-width: 900px) {
    .cookie-shop { grid-template-columns: repeat(2, 1fr); gap: 28px 16px; margin-top: 36px; }
  }
  @media (max-width: 420px) {
    .cookie-shop { gap: 22px 12px; }
  }

  .cookie-prod { display: flex; flex-direction: column; }
  .cookie-prod-photo {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 0.25rem;
    background: #f0ece4;
    border: 1px solid rgba(12, 57, 45, 0.08);
  }
  .cookie-prod-photo img {
    width: 100%; height: 100%;
    /* Visuels détourés (fond transparent) : on montre la plaque entière */
    object-fit: contain; display: block;
    transition: transform 0.55s ease;
  }
  /* Photos non détourées (coffret) : remplissage plein cadre */
  .cookie-prod-photo--cover img { object-fit: cover; }
  .cookie-prod:hover .cookie-prod-photo img { transform: scale(1.05); }

  .cookie-prod-badge {
    position: absolute; top: 12px; left: 12px; z-index: 2;
    font-family: var(--font-sans);
    font-size: 0.55rem; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase;
    padding: 6px 10px; border-radius: 2px;
    color: #fff;
    box-shadow: 0 2px 8px rgba(12, 57, 45, 0.18);
  }
  .cookie-prod-badge--best    { background: #ceb85c; color: #1b1c1c; }
  .cookie-prod-badge--new     { background: #30804e; }
  .cookie-prod-badge--limited { background: #0c392d; }

  .cookie-prod-info { padding: 16px 4px 0; text-align: center; }
  .cookie-prod-name {
    font-family: 'Noto Serif', serif;
    font-size: 1rem; font-weight: 600;
    color: #1b1c1c; margin: 0; line-height: 1.4;
  }
  .cookie-prod-sub {
    display: block; font-family: var(--font-sans);
    font-size: 0.7rem; letter-spacing: 0.02em;
    color: rgba(12, 57, 45, 0.55); margin-top: 5px;
  }
  .cookie-prod-price {
    display: block; font-family: var(--font-sans);
    font-size: 0.92rem; font-weight: 600;
    color: #0c392d; margin-top: 8px;
  }
  @media (max-width: 480px) {
    .cookie-prod-name { font-size: 0.92rem; }
    .cookie-prod-price { font-size: 0.85rem; }
  }

  /* ============================================================
     Encadré conservation
     ============================================================ */
  .cookie-tip {
    display: flex; gap: 20px; align-items: flex-start;
    margin-top: 56px; padding: 32px 36px;
    background: #ffffff;
    border: 1px solid rgba(12, 57, 45, 0.1);
    border-left: 3px solid #ceb85c;
    border-radius: 0.25rem;
  }
  .cookie-tip-mark { color: #ceb85c; font-size: 1.35rem; line-height: 1; flex-shrink: 0; }
  .cookie-tip-title {
    font-family: 'Noto Serif', serif; font-style: italic;
    font-size: 1.25rem; font-weight: 600;
    color: #30804e; margin: 0 0 12px;
  }
  .cookie-tip-text {
    margin: 0; font-family: var(--font-sans);
    font-size: 0.92rem; line-height: 1.75;
    color: rgba(12, 57, 45, 0.78);
    text-align: justify;
  }
  @media (max-width: 480px) {
    .cookie-tip { padding: 24px 20px; gap: 14px; margin-top: 40px; }
    .cookie-tip-title { font-size: 1.1rem; }
    .cookie-tip-text { font-size: 0.86rem; }
  }

  /* ============================================================
     Section head — espacement mobile
     ============================================================ */
  @media (max-width: 600px) {
    .section-head { margin-bottom: 32px; }
  }

  /* ============================================================
     Collections saisonnières
     ============================================================ */
  .collections-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 48px;
  }
  .collection-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 24px;
    background: rgba(247,245,239,0.08);
    border: 1px solid rgba(206,184,92,0.25);
    border-radius: 0.25rem;
    flex: 1 1 180px;
  }
  .collection-mark {
    color: #ceb85c;
    font-family: 'Noto Serif', serif;
    font-size: 0.8rem;
    line-height: 1;
    flex-shrink: 0;
  }
  .collection-label {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.9rem;
    color: #f7f5ef;
    font-weight: 500;
  }

  /* Sur mobile : items pleine largeur */
  @media (max-width: 480px) {
    .collections-grid {
      flex-direction: column;
      gap: 10px;
      margin-top: 28px;
    }
    .collection-item {
      flex: 1 1 100%;
      padding: 14px 16px;
    }
    .collection-label { font-size: 0.85rem; }
  }

  /* ============================================================
     Commandes personnalisées
     ============================================================ */
  .commandes-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 48px;
  }
  .commande-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 24px;
    background: rgba(12, 57, 45,0.04);
    border: 1px solid rgba(206,184,92,0.2);
    border-radius: 0.25rem;
    flex: 1 1 180px;
  }
  .commande-mark {
    color: #ceb85c;
    font-family: 'Noto Serif', serif;
    font-size: 0.8rem;
    line-height: 1;
    flex-shrink: 0;
  }
  .commande-label {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.9rem;
    color: #0c392d;
    font-weight: 500;
  }

  /* Sur mobile : items pleine largeur */
  @media (max-width: 480px) {
    .commandes-grid {
      flex-direction: column;
      gap: 10px;
      margin-top: 28px;
    }
    .commande-item {
      flex: 1 1 100%;
      padding: 14px 16px;
    }
    .commande-label { font-size: 0.85rem; }
  }

  /* ============================================================
     Présence
     ============================================================ */
  .cookie-presence {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    padding: 24px 0 28px;
  }
  .cookie-presence h3 {
    font-family: 'Noto Serif', serif;
    font-style: italic;
    font-size: 1.8rem;
    color: #f7f5ef;
    margin: 0 0 16px;
  }

  @media (max-width: 480px) {
    .cookie-presence { padding: 32px 0; }
    .cookie-presence h3 { font-size: 1.4rem; }
  }

  /* ============================================================
     Pull quote — glassmorphism variant
     ============================================================ */
  .pull-quote-glass {
    background: linear-gradient(135deg, rgba(247,245,239,0.55) 0%, rgba(255,255,255,0.35) 100%);
    backdrop-filter: blur(18px) saturate(1.6);
    -webkit-backdrop-filter: blur(18px) saturate(1.6);
    border-top: 1px solid rgba(206,184,92,0.2);
    border-bottom: 1px solid rgba(206,184,92,0.12);
    position: relative;
    overflow: hidden;
  }
  .pull-quote-glass::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(206,184,92,0.06) 0%, transparent 60%);
    pointer-events: none;
  }

  /* ============================================================
     Pull quote — mobile
     ============================================================ */
  @media (max-width: 600px) {
    .pull-quote { padding: 48px 0; }
    .pull-quote blockquote { font-size: 1.15rem; }
    .pull-quote blockquote br { display: none; }
  }

  /* ============================================================
     Reviews — scroll horizontal mobile
     ============================================================ */
  .reviews-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

  @media (max-width: 640px) {
    .reviews-grid {
      display: flex !important;
      flex-direction: row;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 12px;
      padding-bottom: 12px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      /* Déborde légèrement hors du container pour effet edge-to-edge */
      margin-left: -24px;
      margin-right: -24px;
      padding-left: 24px;
      padding-right: 24px;
    }
    .reviews-grid::-webkit-scrollbar { display: none; }
    .reviews-grid article {
      min-width: 80vw;
      max-width: 80vw;
      scroll-snap-align: start;
      flex-shrink: 0;
      /* Remplace le padding inline trop généreux */
      padding: 24px 20px !important;
    }
    .reviews-grid article p {
      font-size: 0.9rem !important;
    }
    .reviews-grid article footer {
      font-size: 0.58rem !important;
    }
  }

  /* ============================================================
     Box Collections
     ============================================================ */
  .box-collections-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 760px) {
    .box-collections-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  .box-card {
    background: #fff;
    border: 1px solid rgba(12, 57, 45,0.1);
    border-radius: 0.25rem;
    overflow: hidden;
    transition: box-shadow 0.3s;
  }
  .box-card:hover { box-shadow: 0 8px 32px rgba(12, 57, 45,0.1); }
  .box-card-img { position: relative; aspect-ratio: 4/3; overflow: hidden; }
  .box-card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.16,1,0.3,1); }
  .box-card:hover .box-card-img img { transform: scale(1.05); }
  .box-card-badge {
    position: absolute; top: 12px; left: 12px;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.6rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    color: #1b1c1c; background: #ceb85c; padding: 4px 10px; border-radius: 2px;
  }
  .box-card-body { padding: 24px; }
  .box-card-title {
    font-family: 'Noto Serif', serif; font-style: italic; font-weight: 600;
    font-size: 1.3rem; color: #1b1c1c; margin: 0 0 12px;
  }
  .box-card-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
  .box-tag {
    font-family: 'Montserrat', sans-serif; font-size: 0.72rem; font-weight: 500;
    color: #0c392d; background: rgba(12, 57, 45,0.07); border-radius: 2px; padding: 3px 8px;
  }
  .box-card-price {
    font-family: 'Noto Serif', serif; font-style: italic; font-size: 1.05rem; color: #1b1c1c; font-weight: 600;
  }
  .box-card-note {
    font-family: 'Montserrat', sans-serif; font-size: 0.8rem; color: rgba(27, 28, 28,0.5);
    margin-top: 4px;
  }

  /* Box card — padding mobile réduit */
  @media (max-width: 480px) {
    .box-card-body { padding: 18px 16px; }
    .box-card-title { font-size: 1.15rem; }
    .box-card-price { font-size: 0.95rem; }
  }

  /* ============================================================
     CTA band — mobile
     ============================================================ */
  @media (max-width: 600px) {
    .cta-band { padding: 52px 0; }
    .cta-band h2 { font-size: clamp(2.2rem, 10vw, 3.5rem); }
    .cta-band p { font-size: 0.9rem; margin-bottom: 28px; }
    /* Bouton pleine largeur sur très petit écran */
    .cta-band .btn {
      width: 100%;
      justify-content: center;
      padding: 16px 24px;
    }
  }

  /* ============================================================
     Eyebrow — lisibilité mobile garantie
     ============================================================ */
  @media (max-width: 480px) {
    .eyebrow { font-size: 0.62rem; letter-spacing: 0.16em; }
  }

  /* ============================================================
     Sections — espacement vertical réduit sur mobile
     ============================================================ */
  @media (max-width: 480px) {
    .section { padding: 48px 0; }
  }
</style>

<script>
  const els = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const obs = new IntersectionObserver(
      (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-in'); obs.unobserve(e.target); } }),
      { threshold: 0.12, rootMargin: '0px 0px -60px 0px' }
    );
    els.forEach(el => obs.observe(el));
  } else {
    els.forEach(el => el.classList.add('is-in'));
  }
</script>
