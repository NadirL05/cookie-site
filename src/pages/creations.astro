---
import Layout from '../layouts/Layout.astro';

const incontournables = [
  {
    emoji: "🍪",
    name: "Cookie Triple Chocolat",
    desc: "Un cookie généreux fondant à cœur, garni de pépites de chocolat noir, au lait et blanc.",
  },
  {
    emoji: "🍪",
    name: "Cookie Caramel Beurre Salé",
    desc: "La douceur du caramel maison rencontre le croustillant d'une pincée de fleur de sel. Un classique indémodable.",
  },
  {
    emoji: "🍪",
    name: "Cookie Spéculoos",
    desc: "L'arôme envoûtant des épices de Noël dans un cookie moelleux qui plaît à tous les palais.",
  },
];

const collections = [
  { emoji: "🎄", label: "Collection de Noël" },
  { emoji: "❤️", label: "Collection Saint-Valentin" },
  { emoji: "🐣", label: "Collection de Pâques" },
  { emoji: "🎃", label: "Collection Halloween" },
  { emoji: "☀️", label: "Éditions spéciales été" },
];

const commandes = [
  { emoji: "🎉", label: "Anniversaires" },
  { emoji: "💍", label: "Mariages" },
  { emoji: "🏢", label: "Événements professionnels" },
  { emoji: "🎁", label: "Cadeaux gourmands" },
  { emoji: "👨‍👩‍👧‍👦", label: "Réunions familiales" },
];
---

<Layout
  title="Nos Cookies — Cooksbrad"
  description="Découvrez nos cookies artisanaux : incontournables, collections saisonnières et commandes personnalisées."
  current="creations"
>

  <!-- Page banner -->
  <section class="page-banner">
    <div class="container page-banner-inner">
      <div>
        <div class="breadcrumbs">
          <a href="/">Maison</a>
          <span style="color:#D4AF37;font-family:'Noto Serif',serif">✦</span>
          <span style="color:#D4AF37">Nos cookies</span>
        </div>
        <h1>Des créations<br/>gourmandes.</h1>
      </div>
      <div>
        <p>
          Chez CooksBrad, nous imaginons des créations gourmandes qui allient
          simplicité, qualité et générosité.
        </p>
        <div style="margin-top:28px">
          <a href="/contact" class="btn btn-primary">Commander mes cookies →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Galerie photos -->
  <section class="cookie-gallery">
    <div class="cookie-gallery-grid">
      <div class="gallery-item gallery-large">
        <img src="/cookies-hero.jpeg" alt="Cookies caramel CooksBrad" loading="eager" />
      </div>
      <div class="gallery-item">
        <img src="/cookies-kitkat.jpeg" alt="Cookies KitKat CooksBrad" loading="lazy" />
      </div>
      <div class="gallery-item">
        <img src="/cookies-varietes.jpeg" alt="Variétés de cookies CooksBrad" loading="lazy" />
      </div>
      <div class="gallery-item gallery-mid">
        <img src="/cookies-grilles.jpeg" alt="Cookies en production CooksBrad" loading="lazy" />
      </div>
      <div class="gallery-item gallery-wide">
        <img src="/cookies-pecan.jpeg" alt="Cookies pécan CooksBrad" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Nos incontournables -->
  <section class="section bg-cream">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left reveal">
          <span class="eyebrow"><span style="color:#D4AF37">N° 01</span> &nbsp;·&nbsp; Nos Incontournables</span>
          <hr class="hairline" />
          <h2>Nos cookies<br/>classiques.</h2>
        </div>
        <p class="body-text reveal reveal-delay-1">
          Préparés de manière artisanale, nos cookies sont généreux, moelleux à cœur
          et légèrement croustillants à l'extérieur. Des recettes gourmandes qui plaisent
          aussi bien aux petits qu'aux grands.
        </p>
      </div>

      <div class="cookie-cards">
        {incontournables.map((c, i) => (
          <div class={`cookie-card reveal${i > 0 ? " reveal-delay-" + i : ""}`}>
            <span class="cookie-card-emoji">{c.emoji}</span>
            <h3 class="cookie-card-name">{c.name}</h3>
            <p class="cookie-card-desc body-text">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Collections saisonnières -->
  <section class="section bg-forest">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left reveal">
          <span class="eyebrow"><span style="color:#D4AF37">N° 02</span> &nbsp;·&nbsp; Éditions Limitées</span>
          <hr class="hairline" style="background:#D4AF37;opacity:0.4" />
          <h2 style="color:#F7F5EF">Les cookies<br/>des fêtes.</h2>
        </div>
        <p class="body-text reveal reveal-delay-1" style="color:rgba(247,245,239,0.75)">
          Parce que chaque saison mérite sa gourmandise, nous proposons des collections
          éphémères tout au long de l'année — avec des saveurs, décorations et
          présentations exclusives.
        </p>
      </div>

      <div class="collections-grid">
        {collections.map((c, i) => (
          <div class={`collection-item reveal${i > 0 ? " reveal-delay-" + Math.min(i, 3) : ""}`}>
            <span class="collection-emoji">{c.emoji}</span>
            <span class="collection-label">{c.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Vente sur commande -->
  <section class="section bg-cream">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left reveal">
          <span class="eyebrow"><span style="color:#D4AF37">N° 03</span> &nbsp;·&nbsp; Commandes Personnalisées</span>
          <hr class="hairline" />
          <h2>Vente sur<br/>commande.</h2>
        </div>
        <p class="body-text reveal reveal-delay-1">
          Vous souhaitez offrir ou partager nos cookies lors d'un événement particulier ?
          Nos cookies peuvent être adaptés selon vos envies, le nombre de personnes
          et le thème de votre événement.
        </p>
      </div>

      <div class="commandes-grid">
        {commandes.map((c, i) => (
          <div class={`commande-item reveal${i > 0 ? " reveal-delay-" + Math.min(i, 3) : ""}`}>
            <span class="commande-emoji">{c.emoji}</span>
            <span class="commande-label">{c.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Fabrication artisanale -->
  <section class="pull-quote bg-cream" style="border-top:1px solid rgba(0,71,52,0.08)">
    <div class="container reveal">
      <span style="font-family:'Noto Serif',serif;font-style:italic;color:#D4AF37;font-size:1.8rem;display:block;margin-bottom:20px">✦</span>
      <blockquote>
        « Une fabrication artisanale, des ingrédients sélectionnés,<br/>
        et une seule ambition : créer des moments de plaisir et de partage. »
      </blockquote>
      <cite>— CooksBrad</cite>
    </div>
  </section>

  <!-- Retrouvez-nous -->
  <section class="section bg-cream" style="padding-top:0">
    <div class="container">
      <div class="cookie-presence reveal">
        <h3>Retrouvez-nous</h3>
        <p class="body-text">
          Nos cookies sont disponibles sur les marchés, lors d'événements privés et
          professionnels, au sein de notre bar mobile gourmand ainsi que sur commande
          tout au long de l'année.
        </p>
      </div>
    </div>
  </section>

  <!-- Avis clients -->
  <section class="section bg-forest" style="padding-top:56px;padding-bottom:56px">
    <div class="container">
      <div style="text-align:center;margin-bottom:40px" class="reveal">
        <span class="eyebrow" style="color:rgba(212,175,55,0.6);display:block;margin-bottom:8px">Ils nous font confiance</span>
        <span class="bk-stars-gold" style="font-size:0.95rem">★★★★★</span>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px" class="reveal reveal-delay-1">
        <article style="padding:32px;background:rgba(255,255,255,0.05);border-left:2px solid rgba(212,175,55,0.35)">
          <p style="font-family:'Noto Serif',serif;font-style:italic;font-size:1rem;color:rgba(252,249,248,0.85);line-height:1.75;margin:0 0 20px">
            « Des cookies à la fois généreux et raffinés — le caramel beurre salé était une vraie révélation. Nos invités ont tout dévoré en moins d'une heure. »
          </p>
          <footer style="font-family:'Plus Jakarta Sans',sans-serif;font-size:0.6rem;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D4AF37">
            Isabelle T. &nbsp;·&nbsp; <span style="color:rgba(252,249,248,0.45);font-weight:400;text-transform:none;letter-spacing:0">Mariage · Nice</span>
          </footer>
        </article>
        <article style="padding:32px;background:rgba(255,255,255,0.05);border-left:2px solid rgba(212,175,55,0.35)">
          <p style="font-family:'Noto Serif',serif;font-style:italic;font-size:1rem;color:rgba(252,249,248,0.85);line-height:1.75;margin:0 0 20px">
            « Une présentation soignée, des saveurs qui surprennent à chaque bouchée. Nos collaborateurs en parlent encore — un choix qui a fait l'unanimité. »
          </p>
          <footer style="font-family:'Plus Jakarta Sans',sans-serif;font-size:0.6rem;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#D4AF37">
            Marie & Pierre &nbsp;·&nbsp; <span style="color:rgba(252,249,248,0.45);font-weight:400;text-transform:none;letter-spacing:0">Séminaire · Aix-en-Provence</span>
          </footer>
        </article>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-band bg-cream" style="border-top:1px solid rgba(0,71,52,0.08)">
    <div class="container reveal">
      <span class="eyebrow" style="color:#6e5d04;display:block;margin-bottom:8px">Commander</span>
      <h2>Passez votre commande.</h2>
      <p class="body-text">
        Commande personnalisée, devis événementiel ou renseignement : contactez-nous.
      </p>
      <a href="/contact" class="btn btn-primary">
        Nous contacter <span class="arrow">→</span>
      </a>
    </div>
  </section>

</Layout>

<style>
  /* Galerie */
  .cookie-gallery { background: #F7F5EF; padding: 0 0 8px; }
  .cookie-gallery-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: 300px 260px;
    gap: 4px;
  }
  @media (max-width: 760px) {
    .cookie-gallery-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 200px 200px 200px;
    }
    .gallery-large { grid-column: 1 / -1; grid-row: auto; }
    .gallery-mid   { grid-column: auto; grid-row: auto; }
    .gallery-wide  { display: none; }
  }
  .gallery-item { overflow: hidden; }
  .gallery-large { grid-column: 1; grid-row: 1 / 3; }
  .gallery-mid  { grid-column: 2; grid-row: 2; }
  .gallery-wide { grid-column: 3; grid-row: 2; }
  .gallery-item img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16,1,0.3,1);
  }
  .gallery-item:hover img { transform: scale(1.05); }

  /* Incontournables */
  .cookie-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 56px;
  }
  @media (max-width: 760px) { .cookie-cards { grid-template-columns: 1fr; } }

  .cookie-card {
    padding: 36px 32px;
    border: 1px solid rgba(0,71,52,0.1);
    background: #ffffff;
    border-radius: 0.25rem;
    transition: box-shadow 0.3s;
  }
  .cookie-card:hover { box-shadow: 0 8px 32px rgba(0,71,52,0.08); }
  .cookie-card-emoji { font-size: 2rem; display: block; margin-bottom: 20px; }
  .cookie-card-name {
    font-family: 'Noto Serif', serif;
    font-style: italic;
    font-size: 1.25rem;
    color: #002f21;
    margin: 0 0 12px;
    font-weight: 600;
  }
  .cookie-card-desc { margin: 0; }

  /* Collections */
  .collections-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 48px;
  }
  .collection-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 24px;
    background: rgba(247,245,239,0.08);
    border: 1px solid rgba(212,175,55,0.25);
    border-radius: 0.25rem;
    flex: 1 1 180px;
  }
  .collection-emoji { font-size: 1.4rem; }
  .collection-label {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.9rem;
    color: #F7F5EF;
    font-weight: 500;
  }

  /* Commandes */
  .commandes-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 48px;
  }
  .commande-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 24px;
    background: rgba(0,71,52,0.04);
    border: 1px solid rgba(212,175,55,0.2);
    border-radius: 0.25rem;
    flex: 1 1 180px;
  }
  .commande-emoji { font-size: 1.4rem; }
  .commande-label {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.9rem;
    color: #004734;
    font-weight: 500;
  }

  /* Présence */
  .cookie-presence {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    padding: 48px 0;
  }
  .cookie-presence h3 {
    font-family: 'Noto Serif', serif;
    font-style: italic;
    font-size: 1.8rem;
    color: #002f21;
    margin: 0 0 16px;
  }
</style>

<script>
  const els = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const obs = new IntersectionObserver(
      (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-in'); obs.unobserve(e.target); } }),
      { threshold: 0.12, rootMargin: '0px 0px -60px 0px' }
    );
    els.forEach(el => obs.observe(el));
  } else {
    els.forEach(el => el.classList.add('is-in'));
  }
</script>
