---
import Layout from '../layouts/Layout.astro';

const incontournables = [
  {
    emoji: "🍪",
    name: "Cookie Triple Chocolat",
    desc: "Un cookie généreux fondant à cœur, garni de pépites de chocolat noir, au lait et blanc.",
  },
  {
    emoji: "🍪",
    name: "Cookie Caramel Beurre Salé",
    desc: "La douceur du caramel maison rencontre le croustillant d'une pincée de fleur de sel. Un classique indémodable.",
  },
  {
    emoji: "🍪",
    name: "Cookie Spéculoos",
    desc: "L'arôme envoûtant des épices de Noël dans un cookie moelleux qui plaît à tous les palais.",
  },
];

const collections = [
  { emoji: "🎄", label: "Collection de Noël" },
  { emoji: "❤️", label: "Collection Saint-Valentin" },
  { emoji: "🐣", label: "Collection de Pâques" },
  { emoji: "🎃", label: "Collection Halloween" },
  { emoji: "☀️", label: "Éditions spéciales été" },
];

const commandes = [
  { emoji: "🎉", label: "Anniversaires" },
  { emoji: "💍", label: "Mariages" },
  { emoji: "🏢", label: "Événements professionnels" },
  { emoji: "🎁", label: "Cadeaux gourmands" },
  { emoji: "👨‍👩‍👧‍👦", label: "Réunions familiales" },
];
---

<Layout
  title="Nos Créations — Cooksbrad"
  description="Découvrez nos cookies artisanaux : incontournables, collections saisonnières et commandes personnalisées."
  current="creations"
>

  <!-- Page banner -->
  <section class="page-banner">
    <div class="container page-banner-inner">
      <div>
        <div class="breadcrumbs">
          <a href="/">Maison</a>
          <span style="color:#ceb85c;font-family:'Noto Serif',serif">✦</span>
          <span style="color:#ceb85c">Nos Créations</span>
        </div>
        <h1>Des créations<br/>gourmandes.</h1>
      </div>
      <div>
        <p>
          Chez CooksBrad, nous imaginons des créations gourmandes qui allient
          simplicité, qualité et générosité.
        </p>
        <div style="margin-top:28px">
          <a href="/contact" class="btn btn-primary">Commander mes cookies →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Galerie photos -->
  <section class="cookie-gallery">
    <div class="cookie-gallery-grid">
      <div class="gallery-item gallery-large">
        <img src="/cookies-hero.jpeg" alt="Cookies caramel CooksBrad" loading="eager" />
      </div>
    </div>
  </section>

  <!-- Nos incontournables -->
  <section class="section bg-cream">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left reveal">
          <span class="eyebrow"><span style="color:#ceb85c">N° 01</span> &nbsp;·&nbsp; Nos Incontournables</span>
          <hr class="hairline" />
          <h2>Nos cookies<br/>classiques.</h2>
        </div>
        <p class="body-text reveal reveal-delay-1">
          Préparés de manière artisanale, nos cookies sont généreux, moelleux à cœur
          et légèrement croustillants à l'extérieur. Des recettes gourmandes qui plaisent
          aussi bien aux petits qu'aux grands.
        </p>
      </div>

      <div class="cookie-cards">
        {incontournables.map((c, i) => (
          <div class={`cookie-card reveal${i > 0 ? " reveal-delay-" + i : ""}`}>
            <span class="cookie-card-emoji">{c.emoji}</span>
            <h3 class="cookie-card-name">{c.name}</h3>
            <p class="cookie-card-desc body-text">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Collections saisonnières -->
  <section class="section bg-forest">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left reveal">
          <span class="eyebrow"><span style="color:#ceb85c">N° 02</span> &nbsp;·&nbsp; Éditions Limitées</span>
          <hr class="hairline" style="background:#ceb85c;opacity:0.4" />
          <h2 style="color:#f7f5ef">Les cookies<br/>des fêtes.</h2>
        </div>
        <p class="body-text reveal reveal-delay-1" style="color:rgba(247,245,239,0.75)">
          Parce que chaque saison mérite sa gourmandise, nous proposons des collections
          éphémères tout au long de l'année, avec des saveurs, décorations et
          présentations exclusives.
        </p>
      </div>

      <div class="collections-grid">
        {collections.map((c, i) => (
          <div class={`collection-item reveal${i > 0 ? " reveal-delay-" + Math.min(i, 3) : ""}`}>
            <span class="collection-emoji">{c.emoji}</span>
            <span class="collection-label">{c.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Vente sur commande -->
  <section class="section bg-cream">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left reveal">
          <span class="eyebrow"><span style="color:#ceb85c">N° 03</span> &nbsp;·&nbsp; Commandes Personnalisées</span>
          <hr class="hairline" />
          <h2 style="text-align:center">Vente sur<br/>commandes</h2>
        </div>
        <p class="body-text reveal reveal-delay-1">
          Vous souhaitez offrir ou partager nos cookies lors d'un événement particulier ?
          Nos cookies peuvent être adaptés selon vos envies, le nombre de personnes
          et le thème de votre événement.
        </p>
      </div>

      <div class="commandes-grid">
        {commandes.map((c, i) => (
          <div class={`commande-item reveal${i > 0 ? " reveal-delay-" + Math.min(i, 3) : ""}`}>
            <span class="commande-emoji">{c.emoji}</span>
            <span class="commande-label">{c.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Fabrication artisanale -->
  <section class="pull-quote pull-quote-glass" style="border-top:1px solid rgba(12, 57, 45,0.08)">
    <div class="container reveal">
      <span style="font-family:'Noto Serif',serif;font-style:italic;color:#ceb85c;font-size:1.8rem;display:block;margin-bottom:20px">✦</span>
      <blockquote>
        « Une fabrication artisanale, des ingrédients sélectionnés,<br/>
        et une seule ambition : créer des moments de plaisir et de partage. »
      </blockquote>
      <cite>CooksBrad</cite>
    </div>
  </section>

  <!-- Retrouvez-nous -->
  <section class="section bg-cream" style="padding-top:0">
    <div class="container">
      <div class="cookie-presence reveal">
        <h3>Retrouvez-nous</h3>
        <p class="body-text">
          Nos cookies sont disponibles sur les marchés, lors d'événements privés et
          professionnels, au sein de notre bar mobile gourmand ainsi que sur commande
          tout au long de l'année.
        </p>
      </div>
    </div>
  </section>


  <!-- Avis clients -->
  <section class="section bg-forest" style="padding-top:56px;padding-bottom:56px">
    <div class="container">
      <div style="text-align:center;margin-bottom:40px" class="reveal">
        <span class="eyebrow" style="color:rgba(206,184,92,0.6);display:block;margin-bottom:8px">Ils nous font confiance</span>
        <span class="bk-stars-gold" style="font-size:0.95rem">★★★★★</span>
      </div>
      <div class="reviews-grid reveal reveal-delay-1">
        <article style="padding:32px;background:rgba(255,255,255,0.05);border-left:2px solid rgba(206,184,92,0.35)">
          <p style="font-family:'Noto Serif',serif;font-style:italic;font-size:1rem;color:rgba(247,245,239,0.85);line-height:1.75;margin:0 0 20px">
            « Des cookies à la fois généreux et raffinés, le caramel beurre salé était une vraie révélation. Nos invités ont tout dévoré en moins d'une heure. »
          </p>
          <footer style="font-family:'Montserrat',sans-serif;font-size:0.6rem;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#ceb85c">
            Isabelle T. &nbsp;·&nbsp; <span style="color:rgba(247,245,239,0.45);font-weight:400;text-transform:none;letter-spacing:0">Mariage · Nice</span>
          </footer>
        </article>
        <article style="padding:32px;background:rgba(255,255,255,0.05);border-left:2px solid rgba(206,184,92,0.35)">
          <p style="font-family:'Noto Serif',serif;font-style:italic;font-size:1rem;color:rgba(247,245,239,0.85);line-height:1.75;margin:0 0 20px">
            « Une présentation soignée, des saveurs qui surprennent à chaque bouchée. Nos collaborateurs en parlent encore, un choix qui a fait l'unanimité. »
          </p>
          <footer style="font-family:'Montserrat',sans-serif;font-size:0.6rem;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#ceb85c">
            Marie & Pierre &nbsp;·&nbsp; <span style="color:rgba(247,245,239,0.45);font-weight:400;text-transform:none;letter-spacing:0">Séminaire · Aix-en-Provence</span>
          </footer>
        </article>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-band bg-cream" style="border-top:1px solid rgba(12, 57, 45,0.08)">
    <div class="container reveal">
      <span class="eyebrow" style="color:#30804e;display:block;margin-bottom:8px">Commander</span>
      <h2>Passez votre commande.</h2>
      <p class="body-text">
        Commande personnalisée, devis événementiel ou renseignement : contactez-nous.
      </p>
      <a href="/contact" class="btn btn-primary">
        Nous contacter <span class="arrow">→</span>
      </a>
    </div>
  </section>

</Layout>

<style>
  /* ============================================================
     Galerie photos
     ============================================================ */
  .cookie-gallery { background: #f7f5ef; padding: 0 0 8px; }
  .cookie-gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: clamp(320px, 50vw, 560px);
    gap: 4px;
  }
  .gallery-item { overflow: hidden; }
  .gallery-item img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16,1,0.3,1);
  }
  .gallery-item:hover img { transform: scale(1.05); }

  /* Galerie — hauteur réduite sur tablette */
  @media (max-width: 760px) {
    .cookie-gallery-grid {
      grid-template-rows: clamp(260px, 60vw, 420px);
    }
  }

  /* Galerie — hauteur réduite sur petits mobiles */
  @media (max-width: 430px) {
    .cookie-gallery-grid {
      grid-template-rows: 260px;
    }
  }

  /* ============================================================
     Page banner — corrections mobile
     ============================================================ */
  @media (max-width: 600px) {
    .page-banner {
      padding: 56px 0 40px;
    }
    .page-banner h1 {
      font-size: clamp(2.2rem, 10vw, 3.5rem);
      margin-top: 8px;
    }
    .page-banner p {
      font-size: 0.9rem;
      max-width: 100%;
    }
    .page-banner-inner {
      gap: 16px;
    }
  }

  /* ============================================================
     Incontournables — cards
     ============================================================ */
  .cookie-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 56px;
  }
  @media (max-width: 760px) {
    .cookie-cards {
      grid-template-columns: 1fr;
      margin-top: 32px;
      gap: 16px;
    }
  }

  .cookie-card {
    padding: 36px 32px;
    border: 1px solid rgba(12, 57, 45,0.1);
    background: #ffffff;
    border-radius: 0.25rem;
    transition: box-shadow 0.3s;
  }
  .cookie-card:hover { box-shadow: 0 8px 32px rgba(12, 57, 45,0.08); }
  .cookie-card-emoji { font-size: 2rem; display: block; margin-bottom: 20px; }
  .cookie-card-name {
    font-family: 'Noto Serif', serif;
    font-style: italic;
    font-size: 1.25rem;
    color: #1b1c1c;
    margin: 0 0 12px;
    font-weight: 600;
  }
  .cookie-card-desc { margin: 0; }

  /* Padding réduit sur mobile */
  @media (max-width: 480px) {
    .cookie-card { padding: 24px 20px; }
    .cookie-card-emoji { font-size: 1.6rem; margin-bottom: 12px; }
    .cookie-card-name { font-size: 1.1rem; }
  }

  /* ============================================================
     Section head — espacement mobile
     ============================================================ */
  @media (max-width: 600px) {
    .section-head { margin-bottom: 32px; }
  }

  /* ============================================================
     Collections saisonnières
     ============================================================ */
  .collections-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 48px;
  }
  .collection-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 24px;
    background: rgba(247,245,239,0.08);
    border: 1px solid rgba(206,184,92,0.25);
    border-radius: 0.25rem;
    flex: 1 1 180px;
  }
  .collection-emoji { font-size: 1.4rem; }
  .collection-label {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.9rem;
    color: #f7f5ef;
    font-weight: 500;
  }

  /* Sur mobile : items pleine largeur */
  @media (max-width: 480px) {
    .collections-grid {
      flex-direction: column;
      gap: 10px;
      margin-top: 28px;
    }
    .collection-item {
      flex: 1 1 100%;
      padding: 14px 16px;
    }
    .collection-label { font-size: 0.85rem; }
  }

  /* ============================================================
     Commandes personnalisées
     ============================================================ */
  .commandes-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 48px;
  }
  .commande-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 24px;
    background: rgba(12, 57, 45,0.04);
    border: 1px solid rgba(206,184,92,0.2);
    border-radius: 0.25rem;
    flex: 1 1 180px;
  }
  .commande-emoji { font-size: 1.4rem; }
  .commande-label {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.9rem;
    color: #0c392d;
    font-weight: 500;
  }

  /* Sur mobile : items pleine largeur */
  @media (max-width: 480px) {
    .commandes-grid {
      flex-direction: column;
      gap: 10px;
      margin-top: 28px;
    }
    .commande-item {
      flex: 1 1 100%;
      padding: 14px 16px;
    }
    .commande-label { font-size: 0.85rem; }
  }

  /* ============================================================
     Présence
     ============================================================ */
  .cookie-presence {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    padding: 48px 0;
  }
  .cookie-presence h3 {
    font-family: 'Noto Serif', serif;
    font-style: italic;
    font-size: 1.8rem;
    color: #1b1c1c;
    margin: 0 0 16px;
  }

  @media (max-width: 480px) {
    .cookie-presence { padding: 32px 0; }
    .cookie-presence h3 { font-size: 1.4rem; }
  }

  /* ============================================================
     Pull quote — glassmorphism variant
     ============================================================ */
  .pull-quote-glass {
    background: linear-gradient(135deg, rgba(247,245,239,0.55) 0%, rgba(255,255,255,0.35) 100%);
    backdrop-filter: blur(18px) saturate(1.6);
    -webkit-backdrop-filter: blur(18px) saturate(1.6);
    border-top: 1px solid rgba(206,184,92,0.2);
    border-bottom: 1px solid rgba(206,184,92,0.12);
    position: relative;
    overflow: hidden;
  }
  .pull-quote-glass::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(206,184,92,0.06) 0%, transparent 60%);
    pointer-events: none;
  }

  /* ============================================================
     Pull quote — mobile
     ============================================================ */
  @media (max-width: 600px) {
    .pull-quote { padding: 48px 0; }
    .pull-quote blockquote { font-size: 1.15rem; }
    .pull-quote blockquote br { display: none; }
  }

  /* ============================================================
     Reviews — scroll horizontal mobile
     ============================================================ */
  .reviews-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

  @media (max-width: 640px) {
    .reviews-grid {
      display: flex !important;
      flex-direction: row;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 12px;
      padding-bottom: 12px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      /* Déborde légèrement hors du container pour effet edge-to-edge */
      margin-left: -24px;
      margin-right: -24px;
      padding-left: 24px;
      padding-right: 24px;
    }
    .reviews-grid::-webkit-scrollbar { display: none; }
    .reviews-grid article {
      min-width: 80vw;
      max-width: 80vw;
      scroll-snap-align: start;
      flex-shrink: 0;
      /* Remplace le padding inline trop généreux */
      padding: 24px 20px !important;
    }
    .reviews-grid article p {
      font-size: 0.9rem !important;
    }
    .reviews-grid article footer {
      font-size: 0.58rem !important;
    }
  }

  /* ============================================================
     Box Collections
     ============================================================ */
  .box-collections-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 760px) {
    .box-collections-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  .box-card {
    background: #fff;
    border: 1px solid rgba(12, 57, 45,0.1);
    border-radius: 0.25rem;
    overflow: hidden;
    transition: box-shadow 0.3s;
  }
  .box-card:hover { box-shadow: 0 8px 32px rgba(12, 57, 45,0.1); }
  .box-card-img { position: relative; aspect-ratio: 4/3; overflow: hidden; }
  .box-card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.16,1,0.3,1); }
  .box-card:hover .box-card-img img { transform: scale(1.05); }
  .box-card-badge {
    position: absolute; top: 12px; left: 12px;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.6rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    color: #1b1c1c; background: #ceb85c; padding: 4px 10px; border-radius: 2px;
  }
  .box-card-body { padding: 24px; }
  .box-card-title {
    font-family: 'Noto Serif', serif; font-style: italic; font-weight: 600;
    font-size: 1.3rem; color: #1b1c1c; margin: 0 0 12px;
  }
  .box-card-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
  .box-tag {
    font-family: 'Montserrat', sans-serif; font-size: 0.72rem; font-weight: 500;
    color: #0c392d; background: rgba(12, 57, 45,0.07); border-radius: 2px; padding: 3px 8px;
  }
  .box-card-price {
    font-family: 'Noto Serif', serif; font-style: italic; font-size: 1.05rem; color: #1b1c1c; font-weight: 600;
  }
  .box-card-note {
    font-family: 'Montserrat', sans-serif; font-size: 0.8rem; color: rgba(27, 28, 28,0.5);
    margin-top: 4px;
  }

  /* Box card — padding mobile réduit */
  @media (max-width: 480px) {
    .box-card-body { padding: 18px 16px; }
    .box-card-title { font-size: 1.15rem; }
    .box-card-price { font-size: 0.95rem; }
  }

  /* Bouton "Nous contacter" en vert foncé */
  .cta-band .btn-primary { background: #0c392d; color: #f7f5ef; border-color: #0c392d; }
  .cta-band .btn-primary:hover { opacity: 0.88; }

  /* ============================================================
     CTA band — mobile
     ============================================================ */
  @media (max-width: 600px) {
    .cta-band { padding: 52px 0; }
    .cta-band h2 { font-size: clamp(2.2rem, 10vw, 3.5rem); }
    .cta-band p { font-size: 0.9rem; margin-bottom: 28px; }
    /* Bouton pleine largeur sur très petit écran */
    .cta-band .btn {
      width: 100%;
      justify-content: center;
      padding: 16px 24px;
    }
  }

  /* ============================================================
     Eyebrow — lisibilité mobile garantie
     ============================================================ */
  @media (max-width: 480px) {
    .eyebrow { font-size: 0.62rem; letter-spacing: 0.16em; }
  }

  /* ============================================================
     Sections — espacement vertical réduit sur mobile
     ============================================================ */
  @media (max-width: 480px) {
    .section { padding: 48px 0; }
  }
</style>

<script>
  const els = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const obs = new IntersectionObserver(
      (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-in'); obs.unobserve(e.target); } }),
      { threshold: 0.12, rootMargin: '0px 0px -60px 0px' }
    );
    els.forEach(el => obs.observe(el));
  } else {
    els.forEach(el => el.classList.add('is-in'));
  }
</script>
