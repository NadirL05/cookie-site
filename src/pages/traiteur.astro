---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';

const categories = [
  {
    id: 'sucrees',
    label: 'Box Sucrées',
    badge: 'Artisanal',
    image: '/cookies-kitkat.jpeg',
    tags: ['Fruits', 'Cookies & Brownies', 'Verrines'],
    price: 'À partir de 45€',
    note: 'Personnalisable sur devis',
  },
  {
    id: 'salees',
    label: 'Box Salées',
    badge: 'Signature',
    image: '/mini-pancakes-box.jpeg',
    tags: ['Chaude', 'Froide', 'Mixte'],
    price: 'À partir de 55€',
    note: 'Personnalisable sur devis',
  },
  {
    id: 'planches',
    label: 'Nos Planches',
    badge: 'Terroir',
    image: '/cookies-pecan.jpeg',
    tags: ['Fromage', 'Charcuterie', 'Crudités'],
    price: 'À partir de 65€',
    note: 'Personnalisable sur devis',
  },
];

const values = [
  { icon: '🌿', title: 'Sourcing Local', text: 'Produits frais issus de circuits courts et de producteurs passionnés.' },
  { icon: '🍽️', title: 'Fait Maison', text: 'Chaque bouchée préparée avec soin dans notre atelier culinaire.' },
  { icon: '⏱️', title: 'Ponctualité', text: 'Livraison soignée et respect rigoureux de vos horaires d\'événement.' },
  { icon: '✓', title: 'Qualité', text: 'Standards d\'excellence gastronomique, sans compromis.' },
];

const brunchOptions = [
  { label: 'Viennoiseries maison', price: 'Sur devis' },
  { label: 'Fruits frais de saison', price: 'Sur devis' },
  { label: 'Pancakes artisanaux', price: 'Sur devis' },
  { label: 'Mini sandwichs', price: 'Sur devis' },
  { label: 'Boissons fraîches', price: 'Sur devis' },
  { label: 'Boissons chaudes', price: 'Sur devis' },
];
---

<Layout
  title="Traiteur événementiel — Cooksbrad"
  description="Créations traiteur artisanales pour vos événements : box sucrées, box salées, planches, brunch et offres sur mesure."
  current="traiteur"
>

  <!-- Page banner -->
  <section class="page-banner">
    <div class="container page-banner-inner">
      <div>
        <div class="breadcrumbs">
          <a href="/">Maison</a>
          <span style="color:#D4AF37;font-family:'Noto Serif',serif">✦</span>
          <span style="color:#D4AF37">Traiteur</span>
        </div>
        <h1>Service Traiteur<br/>d'Excellence.</h1>
      </div>
      <div>
        <p>
          Des créations artisanales pour vos événements privés et professionnels.
          L'élégance du goût, la précision du geste.
        </p>
        <div style="margin-top:32px">
          <a href="/contact" class="btn btn-ghost">
            Demander un devis <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sub-nav -->
  <nav class="subnav-gh" aria-label="Sections traiteur">
    <div class="container subnav-gh-inner">
      <a href="#collections" class="subnav-gh-link">Nos Collections</a>
      <span style="color:#D4AF37;opacity:0.4">·</span>
      <a href="#brunch" class="subnav-gh-link">Brunch</a>
      <span style="color:#D4AF37;opacity:0.4">·</span>
      <a href="#sur-mesure" class="subnav-gh-link">Sur Mesure</a>
      <span style="color:#D4AF37;opacity:0.4">·</span>
      <a href="#devis" class="subnav-gh-link">Devis</a>
    </div>
  </nav>

  <!-- Collections grid -->
  <section id="collections" class="section bg-cream" style="scroll-margin-top:76px">
    <div class="container">
      <div style="text-align:center;margin-bottom:56px" class="reveal">
        <span class="eyebrow" style="display:block;margin-bottom:12px">Nos Collections</span>
        <h2 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:600;font-size:clamp(1.8rem,3vw,2.8rem);color:#1b1c1c;letter-spacing:-0.02em">
          Créations pour tous vos événements
        </h2>
        <div style="width:48px;height:1px;background:#D4AF37;margin:16px auto 0"></div>
      </div>

      <div class="collections-grid reveal reveal-delay-1">
        {categories.map((cat) => (
          <div class="collection-card gh-card tilt-card">
            <div class="collection-img">
              <img
                src={cat.image}
                alt={cat.label}
                loading="lazy"
              />
              <div class="collection-badge">{cat.badge}</div>
            </div>
            <div class="collection-body">
              <h3 class="collection-title">{cat.label}</h3>
              <div class="collection-tags">
                {cat.tags.map(tag => (
                  <span class="gh-tag">{tag}</span>
                ))}
              </div>
              <div class="collection-footer">
                <p style="font-family:'Noto Serif',serif;font-style:italic;color:#454340;font-size:1rem;margin:0 0 4px">{cat.price}</p>
                <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:0.62rem;letter-spacing:0.16em;text-transform:uppercase;color:#736f6a;margin:0">{cat.note}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Nos valeurs / process -->
  <section class="section bg-cream" style="padding-top:0">
    <div class="container">
      <div class="values-process reveal">
        {values.map((v) => (
          <div class="value-process-item">
            <span class="value-process-icon">{v.icon}</span>
            <h4 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:0.65rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#1b1c1c;margin:0 0 8px">{v.title}</h4>
            <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:0.88rem;color:#454340;line-height:1.65;margin:0">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sur mesure banner -->
  <section id="sur-mesure" class="bg-forest" style="padding:80px 0;scroll-margin-top:76px">
    <div class="container">
      <div style="max-width:800px;margin:0 auto;text-align:center" class="reveal">
        <h2 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:600;font-size:clamp(1.8rem,3.2vw,3rem);color:#fcf9f8;letter-spacing:-0.02em;margin-bottom:24px">
          Un Événement Sur-Mesure ?
        </h2>
        <p class="body-text" style="max-width:560px;margin:0 auto 36px">
          Que ce soit pour un mariage, un séminaire ou une réception privée, nous concevons
          des menus uniques adaptés à vos envies et à votre budget.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:16px;justify-content:center">
          <a href="/contact" class="btn btn-primary">Demander un devis</a>
          <a href="/contact" class="btn btn-ghost">Nous contacter</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Brunch section -->
  <section id="brunch" class="section bg-cream" style="scroll-margin-top:76px">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left reveal">
          <span class="eyebrow"><span style="color:#D4AF37">Brunch</span></span>
          <hr class="hairline" />
          <h2>Une offre généreuse,<br/>pour vos matins.</h2>
        </div>
        <p class="body-text reveal reveal-delay-1">
          Une offre conviviale idéale pour vos événements du matin, lendemains de fête,
          réunions d'équipe ou moments privés.
        </p>
      </div>

      <!-- Brunch photo + options -->
      <div class="brunch-layout reveal">
        <div class="brunch-photo">
          <img
            src="/mini-pancakes-plancha.jpeg"
            alt="Brunch CooksBrad — mini pancakes sur plancha"
            loading="lazy"
          />
        </div>
        <div class="brunch-content">
          <span style="font-family:'Plus Jakarta Sans',sans-serif;font-size:0.65rem;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:#6e5d04;display:block;margin-bottom:20px">Options à l'unité</span>
          <div class="unit-list">
            {brunchOptions.map(opt => (
              <div class="unit-row">
                <span class="unit-name">{opt.label}</span>
                <span style="flex:1;height:1px;background:repeating-linear-gradient(90deg,rgba(42, 39, 36,0.15) 0,rgba(42, 39, 36,0.15) 3px,transparent 3px,transparent 8px);margin:0 12px;align-self:center;min-width:20px"></span>
                <span class="unit-price">{opt.price}</span>
              </div>
            ))}
          </div>
          <a href="/contact" class="btn btn-primary" style="margin-top:32px">
            Réserver mon brunch <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Formulaire devis inline -->
  <section id="devis" class="section bg-cream" style="scroll-margin-top:76px">
    <div class="container">
      <div style="max-width:680px;margin:0 auto">
        <div style="text-align:center;margin-bottom:48px" class="reveal">
          <span class="eyebrow" style="display:block;margin-bottom:12px">Votre Demande</span>
          <h2 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:600;font-size:clamp(1.8rem,3vw,2.8rem);color:#1b1c1c;letter-spacing:-0.02em">
            Parlons de votre projet.
          </h2>
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:0.9rem;color:#454340;margin:12px 0 0">
            Devis gratuit · Réponse sous 24h
          </p>
          <div style="width:48px;height:1px;background:#D4AF37;margin:16px auto 0"></div>
        </div>
        <div style="background:#fff;border:1px solid rgba(42, 39, 36,0.1);padding:40px;border-radius:0.25rem">
          <ContactForm client:load />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="cta-band bg-forest">
    <div class="container reveal">
      <span class="eyebrow" style="color:#D4AF37;display:block;margin-bottom:8px">Votre Événement</span>
      <h2>Composez votre<br/>menu sur mesure.</h2>
      <p class="body-text">
        Notre équipe étudie chaque projet pour proposer une offre traiteur adaptée à vos envies,
        à votre lieu et à votre nombre d'invités.
      </p>
      <a href="/contact" class="btn btn-primary">
        Demander un devis <span class="arrow">→</span>
      </a>
    </div>
  </section>

</Layout>

<style>
  /* Sticky sub-nav */
  .subnav-gh {
    position: sticky;
    top: 76px;
    z-index: 40;
    background: rgba(252, 249, 248, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }
  .subnav-gh-inner {
    display: flex; align-items: center; gap: 24px;
    height: 52px;
  }
  .subnav-gh-link {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.65rem; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: #1b1c1c; text-decoration: none; opacity: 0.65;
    padding: 6px 0; position: relative;
    transition: opacity 0.25s, color 0.25s;
  }
  .subnav-gh-link:hover { opacity: 1; color: #6e5d04; }
  .subnav-gh-link::after {
    content: ''; position: absolute; left: 0; right: 100%;
    bottom: 0; height: 1px; background: #D4AF37;
    transition: right 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .subnav-gh-link:hover::after { right: 0; }

  /* Collections grid */
  .collections-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 900px) { .collections-grid { grid-template-columns: 1fr; } }
  @media (min-width: 600px) and (max-width: 900px) { .collections-grid { grid-template-columns: repeat(2, 1fr); } }

  .collection-card {
    display: flex; flex-direction: column;
    border-radius: 0.25rem; overflow: hidden;
    transition: transform 0.5s cubic-bezier(0.16,1,0.3,1), box-shadow 0.5s cubic-bezier(0.16,1,0.3,1);
  }
  .collection-card:hover { transform: translateY(-6px); box-shadow: 0 24px 56px -16px rgba(27, 28, 28,0.18); }

  .collection-img {
    height: 300px; overflow: hidden; position: relative;
  }
  .collection-img img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16,1,0.3,1), filter 0.5s;
    filter: saturate(0.88) contrast(1.02);
  }
  .collection-card:hover .collection-img img { transform: scale(1.07); filter: saturate(1) contrast(1.04); }
  .collection-badge {
    position: absolute; bottom: 16px; left: 16px;
    background: #2a2724; color: #fcf9f8;
    padding: 4px 12px;
    font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.58rem;
    font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
  }

  .collection-body {
    padding: 28px 28px 32px;
    display: flex; flex-direction: column; gap: 16px; flex: 1;
    text-align: center;
  }
  .collection-title {
    font-family: 'Noto Serif', serif; font-style: italic; font-weight: 500;
    font-size: 1.4rem; color: #1b1c1c; margin: 0;
  }
  .collection-tags {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 6px;
  }
  .collection-footer {
    margin-top: auto; padding-top: 16px;
    border-top: 1px solid rgba(42, 39, 36,0.08);
  }

  /* Values process */
  .values-process {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 48px; padding: 56px 0; text-align: center;
    border-top: 1px solid rgba(42, 39, 36,0.08);
    border-bottom: 1px solid rgba(42, 39, 36,0.08);
  }
  @media (max-width: 900px) { .values-process { grid-template-columns: repeat(2, 1fr); gap: 32px; } }
  @media (max-width: 560px) { .values-process { grid-template-columns: 1fr; } }
  .value-process-item { display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .value-process-icon { font-size: 1.8rem; }

  /* Brunch layout */
  .brunch-layout {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 64px; align-items: start;
  }
  @media (max-width: 860px) { .brunch-layout { grid-template-columns: 1fr; gap: 40px; } }
  .brunch-photo {
    overflow: hidden; border-radius: 0.25rem;
    border: 1px solid rgba(212,175,55,0.15);
  }
  .brunch-photo img {
    width: 100%; aspect-ratio: 4/3; object-fit: cover;
    filter: saturate(0.88) contrast(1.02);
    transition: transform 0.8s cubic-bezier(0.16,1,0.3,1);
  }
  .brunch-photo:hover img { transform: scale(1.04); }
  .brunch-content { padding-top: 8px; }
</style>

<script>
  const els = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const obs = new IntersectionObserver(
      (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-in'); obs.unobserve(e.target); } }),
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );
    els.forEach(el => obs.observe(el));
  } else {
    els.forEach(el => el.classList.add('is-in'));
  }
</script>
