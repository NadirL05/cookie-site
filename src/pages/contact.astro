---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';
---

<Layout
  title="Contact — Cooksbrad"
  description="Demandez votre devis gratuit pour un bar mobile événementiel en région PACA."
  current="contact"
>

  <!-- Page banner -->
  <section class="page-banner">
    <div class="container page-banner-inner">
      <div>
        <div class="breadcrumbs">
          <a href="/">Maison</a>
          <span style="color:#D4AF37;font-family:'Noto Serif',serif">✦</span>
          <span style="color:#D4AF37">Contact</span>
        </div>
        <h1>Organisons votre<br/>prochain événement.</h1>
      </div>
      <div>
        <p>
          Vous souhaitez obtenir un devis ou en savoir plus sur nos prestations ?
          Contactez-nous dès aujourd'hui et recevez votre devis gratuit sous 48h.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact content -->
  <section class="section bg-cream">
    <div class="container">
      <div class="contact-layout">

        <!-- Form -->
        <div class="contact-form-col reveal">
          <span class="eyebrow" style="display:block;margin-bottom:24px"><span style="color:#D4AF37">N° 01</span> &nbsp;·&nbsp; Votre Demande</span>
          <div class="contact-form-box">
            <ContactForm client:load />
          </div>
        </div>

        <!-- Info sidebar -->
        <div class="contact-info-col reveal reveal-delay-1">
          <span class="eyebrow" style="display:block;margin-bottom:24px"><span style="color:#D4AF37">N° 02</span> &nbsp;·&nbsp; Retrouvez-nous</span>

          <!-- Coordinates card -->
          <div class="contact-coords">
            <h2 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:500;font-size:1.3rem;color:#002f21;margin:0 0 24px">Nos Coordonnées</h2>
            <ul class="contact-coords-list">
              <li>
                <div class="contact-coord-item">
                  <span class="contact-coord-label">Instagram</span>
                  <a href="https://instagram.com/cooksbrad_atelier" target="_blank" rel="noopener noreferrer" class="contact-coord-value link-ul">@cooksbrad_atelier</a>
                </div>
              </li>
              <li>
                <div class="contact-coord-item">
                  <span class="contact-coord-label">TikTok</span>
                  <a href="https://www.tiktok.com/@cooksbrad" target="_blank" rel="noopener noreferrer" class="contact-coord-value link-ul">@cooksbrad</a>
                </div>
              </li>
              <li>
                <div class="contact-coord-item">
                  <span class="contact-coord-label">E-mail</span>
                  <a href="mailto:cooksbrad.pro@gmail.com" class="contact-coord-value link-ul">cooksbrad.pro@gmail.com</a>
                </div>
              </li>
              <li>
                <div class="contact-coord-item">
                  <span class="contact-coord-label">Localisation</span>
                  <span class="contact-coord-value">Région PACA</span>
                </div>
              </li>
              <li>
                <div class="contact-coord-item">
                  <span class="contact-coord-label">Réservations</span>
                  <span class="contact-coord-value">Via Instagram ou e-mail — 72h à l'avance.</span>
                </div>
              </li>
            </ul>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- L'atelier / philosophy section -->
  <section class="section bg-cream" style="padding-top:0">
    <div class="container">
      <hr class="hairline-long" />
      <div class="contact-philosophy reveal">
        <div>
          <h2 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:600;font-size:clamp(1.6rem,2.8vw,2.4rem);color:#002f21;letter-spacing:-0.02em;margin:0 0 16px">
            L'Atelier CooksBrad
          </h2>
          <p class="body-text" style="margin-bottom:16px">
            Basés en région PACA, nous nous déplaçons directement sur votre lieu de réception
            pour apporter nos animations gourmandes et nos bars éphémères.
          </p>
          <p class="body-text" style="margin:0">
            Chaque projet est une collaboration intime entre notre savoir-faire et vos désirs.
          </p>
        </div>
        <div class="contact-map">
          <iframe
            src="https://maps.google.com/maps?q=Provence-Alpes-C%C3%B4te+d%27Azur%2C+France&hl=fr&z=8&output=embed"
            width="100%"
            height="300"
            style="border:0;border-radius:0.25rem;display:block"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Zone d intervention CooksBrad PACA"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .contact-layout {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 80px;
    align-items: start;
  }
  @media (max-width: 860px) {
    .contact-layout { grid-template-columns: 1fr; gap: 52px; }
  }

  /* Form box */
  .contact-form-box {
    background: #ffffff;
    border: 1px solid rgba(0,71,52,0.1);
    padding: 40px;
    border-radius: 0.25rem;
  }
  @media (max-width: 560px) { .contact-form-box { padding: 24px; } }

  /* Coordinates card */
  .contact-coords {
    background: #ffffff;
    border: 1px solid rgba(0,71,52,0.1);
    padding: 32px;
    border-radius: 0.25rem;
    margin-bottom: 16px;
  }
  .contact-coords-list {
    list-style: none; padding: 0; margin: 0;
  }
  .contact-coord-item {
    display: flex; flex-direction: column; gap: 4px;
    padding: 14px 0; border-bottom: 1px solid rgba(0,71,52,0.08);
  }
  .contact-coords-list li:last-child .contact-coord-item { border-bottom: none; padding-bottom: 0; }
  .contact-coords-list li:first-child .contact-coord-item { padding-top: 0; }
  .contact-coord-label {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.6rem; font-weight: 700; letter-spacing: 0.2em;
    text-transform: uppercase; color: #6e5d04;
  }
  .contact-coord-value {
    font-family: 'Noto Serif', serif; font-style: italic;
    font-size: 1.05rem; color: #002f21; text-decoration: none;
  }
  a.contact-coord-value:hover { color: #6e5d04; }

  /* Philosophy section */
  .contact-philosophy {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 64px; align-items: center;
    padding-top: 52px;
  }
  @media (max-width: 760px) { .contact-philosophy { grid-template-columns: 1fr; gap: 32px; } }

  /* Map */
  .contact-map {
    overflow: hidden;
    border-radius: 0.25rem;
    border: 1px solid rgba(212,175,55,0.2);
    margin-top: 0;
  }
</style>

<script>
  const els = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const obs = new IntersectionObserver(
      (entries) => entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('is-in'); obs.unobserve(e.target); }
      }),
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );
    els.forEach(el => obs.observe(el));
  } else {
    els.forEach(el => el.classList.add('is-in'));
  }
</script>
