---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';
---

<Layout
  title="Contact — Cooksbrad"
  description="Demandez votre devis gratuit pour un bar mobile événementiel en région PACA."
  current="contact"
>

  <!-- Page banner -->
  <section class="page-banner">
    <div class="container page-banner-inner">
      <div>
        <div class="breadcrumbs">
          <a href="/">Maison</a>
          <span style="color:#ceb85c;font-family:'Noto Serif',serif">✦</span>
          <span style="color:#ceb85c">Contact</span>
        </div>
        <h1>Organisons votre<br/>prochain événement.</h1>
      </div>
      <div>
        <p style="text-align:justify">
          Vous souhaitez obtenir un devis ou en savoir plus sur nos prestations ?
          Contactez-nous dès aujourd'hui et recevez votre devis gratuit sous 48h.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact content -->
  <section class="section bg-cream">
    <div class="container">
      <div class="contact-layout">

        <!-- Form -->
        <div class="contact-form-col reveal">
          <span class="eyebrow" style="display:block;margin-bottom:24px"><span style="color:#ceb85c">N° 01</span> &nbsp;·&nbsp; Votre Demande</span>
          <div class="contact-form-box">
            <ContactForm client:load />
          </div>
        </div>

        <!-- Info sidebar -->
        <div class="contact-info-col reveal reveal-delay-1">
          <span class="eyebrow" style="display:block;margin-bottom:24px"><span style="color:#ceb85c">N° 02</span> &nbsp;·&nbsp; Retrouvez-nous</span>

          <!-- Coordinates card -->
          <div class="contact-coords">
            <h2 style="font-family:'Noto Serif',serif;font-style:italic;font-weight:500;font-size:1.3rem;color:#30804e;margin:0 0 24px">Nos Coordonnées</h2>
            <ul class="contact-coords-list">
              <li>
                <div class="contact-coord-item">
                  <span class="contact-coord-label">Instagram</span>
                  <a href="https://www.instagram.com/maison.cooksbrad/" target="_blank" rel="noopener noreferrer" class="contact-coord-value link-ul">@maison.cooksbrad</a>
                </div>
              </li>
              <li>
                <div class="contact-coord-item">
                  <span class="contact-coord-label">TikTok</span>
                  <a href="https://www.tiktok.com/@cooksbrad" target="_blank" rel="noopener noreferrer" class="contact-coord-value link-ul">@cooksbrad</a>
                </div>
              </li>
              <li>
                <div class="contact-coord-item">
                  <span class="contact-coord-label">E-mail</span>
                  <a href="mailto:cooksbrad.pro@gmail.com" class="contact-coord-value link-ul">cooksbrad.pro@gmail.com</a>
                </div>
              </li>
              <li>
                <div class="contact-coord-item">
                  <span class="contact-coord-label">Localisation</span>
                  <span class="contact-coord-value">Région PACA</span>
                </div>
              </li>
              <li>
                <div class="contact-coord-item">
                  <span class="contact-coord-label">Réservations</span>
                  <span class="contact-coord-value">Via Instagram ou e-mail, 72h à l'avance.</span>
                </div>
              </li>
            </ul>
          </div>

        </div>

      </div>
    </div>
  </section>


</Layout>

<style>
  /* ── Contact layout : 2 colonnes desktop, info d'abord sur mobile ── */
  .contact-layout {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 80px;
    align-items: start;
  }

  @media (max-width: 860px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    /* Coordonnées (2e col dans le DOM) affichées en 1er sur mobile */
    .contact-info-col  { order: 1; }
    .contact-form-col  { order: 2; }
  }

  /* ── Form box ── */
  .contact-form-box {
    background: #ffffff;
    border: 1px solid rgba(12, 57, 45,0.1);
    padding: 40px;
    border-radius: 0.25rem;
  }

  @media (max-width: 560px) {
    .contact-form-box { padding: 20px 16px; }
  }

  /* ── Coordinates card ── */
  .contact-coords {
    background: #ffffff;
    border: 1px solid rgba(12, 57, 45,0.1);
    padding: 32px;
    border-radius: 0.25rem;
    margin-bottom: 16px;
  }

  @media (max-width: 560px) {
    .contact-coords { padding: 20px 16px; }
  }

  .contact-coords-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .contact-coord-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    /* min 44px touch target via padding vertical */
    padding: 14px 0;
    border-bottom: 1px solid rgba(12, 57, 45,0.08);
    min-height: 44px;
    justify-content: center;
  }

  .contact-coords-list li:last-child .contact-coord-item {
    border-bottom: none;
    padding-bottom: 0;
  }

  .contact-coords-list li:first-child .contact-coord-item {
    padding-top: 0;
  }

  .contact-coord-label {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #30804e;
  }

  .contact-coord-value {
    font-family: 'Noto Serif', serif;
    font-style: italic;
    font-size: 1.05rem;
    color: #1b1c1c;
    text-decoration: none;
    /* liens cliquables : zone tactile étendue */
    display: inline-block;
  }

  a.contact-coord-value {
    padding: 2px 0;
  }

  a.contact-coord-value:hover { color: #30804e; }

  /* ── Philosophy section ── */
  .contact-philosophy {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    padding-top: 52px;
  }

  @media (max-width: 760px) {
    .contact-philosophy {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-top: 36px;
    }
  }

  /* ── Map ── */
  .contact-map {
    overflow: hidden;
    border-radius: 0.25rem;
    border: 1px solid rgba(206,184,92,0.2);
    margin-top: 0;
  }

  @media (max-width: 560px) {
    .contact-map iframe {
      height: 260px !important;
    }
  }

  /* ── Hero banner mobile ── */
  @media (max-width: 560px) {
    .page-banner { padding-top: 48px; padding-bottom: 48px; }
    .page-banner-inner { gap: 16px; }
    .page-banner h1 { font-size: clamp(1.75rem, 7vw, 2.8rem); }
  }
</style>

<script>
  const els = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const obs = new IntersectionObserver(
      (entries) => entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('is-in'); obs.unobserve(e.target); }
      }),
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );
    els.forEach(el => obs.observe(el));
  } else {
    els.forEach(el => el.classList.add('is-in'));
  }
</script>
