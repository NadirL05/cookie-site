---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';
---

<Layout
  title="Contact — La Maison"
  description="Pour commander, poser une question ou proposer un événement."
  current="contact"
  forestTop={true}
>

  <!-- Page banner -->
  <section class="page-banner">
    <div class="container page-banner-inner">
      <div>
        <div class="breadcrumbs">
          <a href="/">Maison</a>
          <span class="ornament" style="font-size:0.9rem">✦</span>
          <span style="color:#9C8870">Contact</span>
        </div>
        <h1>Écrivez-nous<br/>la veille au soir.</h1>
      </div>
      <p>
        Pour commander, poser une question ou proposer un événement.
        Réponse sous 24h par e-mail ou Instagram.
      </p>
    </div>
  </section>

  <!-- Contenu principal -->
  <section class="section bg-cream">
    <div class="container">
      <div class="contact-grid">

        <!-- Formulaire -->
        <div class="reveal">
          <span class="eyebrow" style="color:#9C8870;display:block;margin-bottom:24px">N° 01 &nbsp;·&nbsp; Formulaire</span>
          <ContactForm client:load />
        </div>

        <!-- Infos -->
        <div class="contact-info reveal reveal-delay-1">
          <span class="eyebrow" style="color:#9C8870;display:block;margin-bottom:24px">N° 02 &nbsp;·&nbsp; Retrouvez-nous</span>
          <div class="contact-info-list">
            <div class="contact-info-item">
              <span class="contact-info-label">Instagram</span>
              <a href="https://instagram.com/lamaisoncookies" target="_blank" rel="noopener noreferrer" class="contact-info-value link-ul">@lamaisoncookies</a>
            </div>
            <div class="contact-info-item">
              <span class="contact-info-label">E-mail</span>
              <a href="mailto:hello@lamaisoncookies.fr" class="contact-info-value link-ul">hello@lamaisoncookies.fr</a>
            </div>
            <div class="contact-info-item">
              <span class="contact-info-label">Localisation</span>
              <span class="contact-info-value">Paris, 4ᵉ arrondissement</span>
            </div>
            <div class="contact-info-item">
              <span class="contact-info-label">Commandes</span>
              <span class="contact-info-value">Via Instagram ou e-mail — 72h à l'avance, retrait à l'atelier.</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 80px;
    align-items: start;
  }
  @media (max-width: 860px) {
    .contact-grid { grid-template-columns: 1fr; gap: 48px; }
  }

  .contact-info-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .contact-info-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 0;
    border-bottom: 1px solid rgba(28,58,42,0.1);
  }
  .contact-info-item:first-child { padding-top: 0; }
  .contact-info-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(44,24,16,0.45);
  }
  .contact-info-value {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 1.15rem;
    color: #2C1810;
    text-decoration: none;
  }
  a.contact-info-value:hover { color: #1C3A2A; }
</style>

<script>
  const els = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const obs = new IntersectionObserver(
      (entries) => entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('is-in'); obs.unobserve(e.target); }
      }),
      { threshold: 0.12, rootMargin: '0px 0px -60px 0px' }
    );
    els.forEach(el => obs.observe(el));
  } else {
    els.forEach(el => el.classList.add('is-in'));
  }
</script>
