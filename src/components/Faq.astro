---
interface Item {
  q: string;
  a: string;
}
interface Props {
  title?: string;
  items: Item[];
}

const { title = 'Questions fréquentes', items } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
---

<section class="section bg-cream" aria-labelledby="faq-title">
  <div class="container" style="max-width:820px">
    <div style="text-align:center;margin-bottom:40px">
      <span class="eyebrow" style="display:block;margin-bottom:12px">FAQ</span>
      <h2
        id="faq-title"
        style="font-family:'Noto Serif',serif;font-style:italic;font-weight:600;font-size:clamp(2rem,4vw,3rem);color:#1b1c1c;letter-spacing:-0.02em"
      >
        {title}
      </h2>
    </div>
    <div>
      {
        items.map((i) => (
          <details style="border-bottom:1px solid rgba(12,57,45,.18);padding:18px 0">
            <summary style="cursor:pointer;font-family:'Noto Serif',serif;font-size:1.15rem;color:#0c392d;list-style-position:outside">
              {i.q}
            </summary>
            <p style="margin:12px 0 0;font-family:Montserrat,sans-serif;font-size:.95rem;line-height:1.7;color:#1b1c1c">
              {i.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
