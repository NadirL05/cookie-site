---
const year = new Date().getFullYear();
---

<footer class="footer-rich">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="footer-wordmark">Cooksbrad</div>
        <p class="body-text" style="max-width:340px;margin-top:16px;">
          Atelier culinaire & bar mobile événementiel. Des créations artisanales pour vos moments les plus précieux.
        </p>
      </div>

      <div class="footer-cols">
        <div class="footer-col">
          <span class="eyebrow">Navigation</span>
          <ul>
            <li><a href="/" class="link-ul">Maison</a></li>
            <li><a href="/traiteur" class="link-ul">Traiteur</a></li>
            <li><a href="/bar-mobile" class="link-ul">Bar Mobile</a></li>
            <li><a href="/creations" class="link-ul">Nos Créations</a></li>
            <li><a href="/histoire" class="link-ul">Notre Histoire</a></li>
            <li><a href="/contact" class="link-ul">Contact</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <span class="eyebrow">Réservation</span>
          <ul>
            <li><a href="https://instagram.com/cooksbrad_atelier" class="link-ul" target="_blank" rel="noopener">@cooksbrad_atelier</a></li>
            <li><a href="mailto:atelier@cooksbrad.fr" class="link-ul">atelier@cooksbrad.fr</a></li>
            <li><span style="opacity:0.6">Réservation 72h à l'avance</span></li>
          </ul>
        </div>
        <div class="footer-col">
          <span class="eyebrow">Atelier</span>
          <ul>
            <li>Paris, 4ᵉ arrondissement</li>
            <li>Mar–Sam · 10h → 18h</li>
            <li><a href="/contact" class="link-ul">Nous contacter</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} Cooksbrad Atelier Culinaire — Tous droits réservés</span>
      <span style="color:#D4AF37;font-family:'Noto Serif',serif;font-style:italic">✦</span>
      <span>Fait avec soin, depuis 2015</span>
    </div>
  </div>
</footer>
