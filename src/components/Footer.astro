---
const year = new Date().getFullYear();
---

<footer class="footer-rich">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="footer-wordmark">CooksBrad</div>
        <p class="body-text footer-brand-desc">
          Atelier culinaire &amp; bar mobile événementiel. Des créations artisanales pour vos moments les plus précieux.
        </p>
      </div>

      <!-- 3 colonnes desktop → 1 colonne mobile via CSS grid -->
      <div class="footer-cols">
        <div class="footer-col">
          <span class="eyebrow">Navigation</span>
          <ul class="footer-link-list">
            <li><a href="/" class="link-ul footer-link">Maison</a></li>
            <li><a href="/bar-mobile" class="link-ul footer-link">Bar Mobile</a></li>
            <li><a href="/creations" class="link-ul footer-link">Nos Créations</a></li>
            <li><a href="/histoire" class="link-ul footer-link">Notre Histoire</a></li>
            <li><a href="/contact" class="link-ul footer-link">Contact</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <span class="eyebrow">Réservation</span>
          <ul class="footer-link-list">
            <li>
              <div class="footer-socials">
                <a
                  href="https://www.instagram.com/maison.cooksbrad/"
                  class="footer-social-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Instagram CooksBrad"
                >
                  <svg class="footer-social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                  <span>@maison.cooksbrad</span>
                </a>
                <a
                  href="https://www.tiktok.com/@cooksbrad"
                  class="footer-social-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="TikTok CooksBrad"
                >
                  <svg class="footer-social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                  </svg>
                  <span>@cooksbrad</span>
                </a>
              </div>
            </li>
            <li>
              <a href="mailto:cooksbrad.pro@gmail.com" class="link-ul footer-link">
                cooksbrad.pro@gmail.com
              </a>
            </li>
            <li><a href="/contact" class="link-ul footer-link">Réservation 72h à l'avance</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <span class="eyebrow">Zone d'intervention</span>
          <ul class="footer-link-list">
            <li><span class="footer-note">Région PACA</span></li>
            <li><span class="footer-note">Déplacements sur toute la région</span></li>
            <li><a href="/contact" class="link-ul footer-link">Nous contacter</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} CooksBrad Atelier Culinaire · Tous droits réservés</span>
      <span class="footer-ornament" aria-hidden="true">✦</span>
      <nav class="footer-legal" aria-label="Liens légaux">
        <a href="/mentions-legales" class="link-ul">Mentions légales</a>
        <span class="footer-legal-sep" aria-hidden="true">·</span>
        <a href="/confidentialite" class="link-ul">Politique de confidentialité</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  /* ── Icônes sociales ── */
  .footer-socials {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-block: 4px;
  }

  .footer-social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .footer-social-link:hover {
    color: #ceb85c;
  }

  .footer-social-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  /* ── Touch targets ≥ 44px pour tous les liens du footer ── */
  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: 2px;
  }

  /* ── Liste sans puce, espacement cohérent ── */
  .footer-link-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-link-list li {
    display: flex;
    align-items: center;
  }

  /* Texte non-cliquable dans le footer */
  /* Même intensité que les liens de la même colonne (pas de texte grisé) */
  .footer-note {
    font-size: 0.9rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  /* Description de la marque */
  .footer-brand-desc {
    max-width: 340px;
    margin-top: 16px;
    color: rgba(27, 28, 28, 0.55);
  }

  /* ── Layout footer-top : brand + 3 colonnes ── */
  .footer-top {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* ── 3 colonnes desktop → 1 colonne mobile ── */
  .footer-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  /* ── Copyright centré sur mobile ── */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
  }

  .footer-ornament {
    color: #ceb85c;
    font-family: 'Noto Serif', serif;
    font-style: italic;
  }

  /* ── Liens légaux (RGPD / LCEN) ── */
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.78rem;
    opacity: 0.7;
  }
  .footer-legal a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .footer-legal-sep { opacity: 0.5; }

  /* ── Tablet : 2 colonnes ── */
  @media (min-width: 640px) {
    .footer-cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ── Desktop : layout horizontal brand + 3 colonnes ── */
  @media (min-width: 1024px) {
    .footer-top {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 4rem;
    }

    .footer-brand {
      flex-shrink: 0;
    }

    .footer-cols {
      grid-template-columns: repeat(3, 1fr);
      flex: 1;
      gap: 2.5rem;
    }

    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
</style>
